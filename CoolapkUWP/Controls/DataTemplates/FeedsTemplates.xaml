<ResourceDictionary
    x:Class="CoolapkUWP.Controls.DataTemplates.FeedsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="using:CoolapkUWP.Controls"
    xmlns:converters="using:CoolapkUWP.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CoolapkUWP.Controls.DataTemplates"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:feedmodels="using:CoolapkUWP.Models.Feeds"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <local:PicTemplates />
        <local:RelationRowsTemplates />
    </ResourceDictionary.MergedDictionaries>

    <converters:HTMLToTextConverter x:Key="HTMLToTextConverter" />

    <DataTemplate x:Key="FeedDefaultTemplate" x:DataType="feedmodels:FeedModel">
        <UserControl
            x:Name="Root"
            Background="{StaticResource SystemControlTransparentBrush}"
            Loaded="UserControl_Loaded"
            SizeChanged="UserControl_SizeChanged"
            Tag="{x:Bind Url, Mode=OneWay}"
            Tapped="OnRootTapped">
            <UserControl.Resources>
                <Flyout x:Key="QRCodeFlyout" ShouldConstrainToRootBounds="False">
                    <Flyout.FlyoutPresenterStyle>
                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <controls:ShowQRCodeControl QRCodeText="{x:Bind ShareUrl, Mode=OneWay}" />
                </Flyout>
                <MenuFlyout x:Key="MoreFlyout">
                    <MenuFlyoutSubItem x:Uid="/Feed/Copy">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                        </MenuFlyoutSubItem.Icon>
                        <ToggleMenuFlyoutItem
                            x:Name="CopyButton"
                            x:Uid="/Feed/CopyFree"
                            IsChecked="{x:Bind IsCopyEnabled, Mode=TwoWay}" />
                        <MenuFlyoutItem
                            x:Uid="/Feed/CopyLink"
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind ShareUrl, Mode=OneWay}" />
                        <MenuFlyoutItem
                            x:Uid="/Feed/CopyAll"
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind Message, Converter={StaticResource HTMLToTextConverter}, Mode=OneWay}" />
                        <MenuFlyoutItem
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='@{0}', Mode=OneWay}"
                            Text="{x:Bind UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='复制 @{0}', Mode=OneWay}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem
                        x:Name="PinTileButton"
                        x:Uid="/Feed/PinTile"
                        Click="FeedButton_Click"
                        Tag="{x:Bind Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE840;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="ReportButton"
                        x:Uid="/Feed/Report"
                        Click="FeedButton_Click"
                        Tag="{x:Bind ID, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://m.coolapk.com/mp/do?c=feed&amp;m=report&amp;type=feed&amp;id={0}', Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </UserControl.Resources>
            <Grid
                Padding="8,4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                ContextFlyout="{StaticResource MoreFlyout}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    x:Name="StickUp"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Visibility="{x:Bind IsStickTop, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <FontIcon
                        Margin="4,0,0,0"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Foreground="Red"
                        Glyph="&#xE840;" />
                    <TextBlock
                        x:Uid="/Feed/StickUp"
                        Margin="5,4,5,5"
                        HorizontalAlignment="Left"
                        Foreground="Red"
                        IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    x:Name="UserBar"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Visibility="{x:Bind ShowUser, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Button
                        Margin="0,4"
                        Padding="0"
                        Background="{ThemeResource SystemControlTransparentBrush}"
                        Click="Button_Click"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind UserInfo.Url, Mode=OneWay}">
                        <muxc:PersonPicture
                            Width="36"
                            Height="36"
                            DisplayName="{x:Bind UserInfo.UserName, Mode=OneWay}"
                            ProfilePicture="{x:Bind UserInfo.UserAvatar.Pic, Mode=OneWay}" />
                    </Button>
                    <Grid Margin="8,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                            Text="{x:Bind UserInfo.UserName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ShowDateline, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                            <Run Text="{x:Bind InfoHTML, Mode=OneWay}" />
                            <Run Text="{x:Bind Info, Mode=OneWay}" />
                            <Hyperlink
                                Click="DeviceHyperlink_Click"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                UnderlineStyle="None">
                                <Run Text="{x:Bind DeviceTitle, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ShowDateline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <Run Text="{x:Bind Dateline, Mode=OneWay}" />
                            <Run Text="{x:Bind Info, Mode=OneWay}" />
                            <Hyperlink
                                Click="DeviceHyperlink_Click"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                UnderlineStyle="None">
                                <Run Text="{x:Bind DeviceTitle, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <controls:StackPanel
                    x:Name="BtnsPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="2"
                    Visibility="{x:Bind ShowButtons, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Button
                        x:Name="LikeButton"
                        x:Uid="/Feed/LikeButton"
                        Height="32"
                        Click="FeedButton_Click"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind Mode=OneWay}"
                        Visibility="{x:Bind ShowLikes, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8E1;"
                                Visibility="{x:Bind Liked, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Glyph="&#xE8E1;"
                                Visibility="{x:Bind Liked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
                            <TextBlock Margin="8,0,0,0" Text="{x:Bind LikeNum, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ReplyButton"
                        x:Uid="/Feed/ReplyButton"
                        Height="32"
                        Click="FeedButton_Click"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind Mode=OneWay}"
                        Visibility="{x:Bind ShowLikes, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE90A;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind ReplyNum, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ShareButton"
                        x:Uid="/Feed/ShareButton"
                        Height="32"
                        Click="FeedButton_Click"
                        Flyout="{StaticResource QRCodeFlyout}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind ShareUrl, Mode=OneWay}"
                        Visibility="{x:Bind ShowLikes, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind ShareNum, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        x:Uid="/Feed/MoreButton"
                        Height="32"
                        Flyout="{StaticResource MoreFlyout}"
                        Style="{StaticResource TransparentButtonStyle}">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE10C;" />
                    </Button>
                </controls:StackPanel>
                <TextBlock
                    x:Name="MessageTitle"
                    Grid.Row="3"
                    Margin="4"
                    HorizontalAlignment="Left"
                    FontSize="16"
                    FontWeight="Black"
                    IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                    Text="{x:Bind MessageTitle, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind MessageTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <controls:StackPanel
                    Grid.Row="4"
                    Margin="4"
                    Spacing="4">
                    <Grid Margin="0,-4" Visibility="{x:Bind IsRatingFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <TextBlock
                                x:Uid="/Feed/Rating"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <muxc:RatingControl
                            x:Name="RatingStarControl"
                            Grid.Column="1"
                            Margin="8,7,8,0"
                            IsReadOnly="True"
                            Value="{x:Bind RatingStar, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind RatingStar, Converter={StaticResource NumMultConverter}, ConverterParameter='2', Mode=OneWay}" />
                            <Run Text="分" />
                        </TextBlock>
                    </Grid>
                    <controls:TextBlockEx
                        x:Name="Message"
                        HorizontalAlignment="Left"
                        IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                        Text="{x:Bind Message, Mode=OneWay}"
                        Visibility="{x:Bind Message, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </controls:StackPanel>
                <GridView
                    Grid.Row="5"
                    MinHeight="0"
                    Margin="4"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    ItemTemplate="{StaticResource PicDefaultTemplate}"
                    ItemsSource="{x:Bind PicArr, Mode=OneWay}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionChanged="GridView_SelectionChanged"
                    Visibility="{x:Bind PicArr, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
                <StackPanel
                    Grid.Row="6"
                    Margin="0,4"
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="{x:Bind VoteRows, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <muxc:ItemsRepeater
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource VoteItemTemplate}"
                        ItemsSource="{x:Bind VoteRows, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}">
                            <Run FontWeight="Bold" Text="{x:Bind TotalVoteNum, Mode=OneWay}" />
                            <Run Text="人投票" />
                            <Run Text="•" />
                            <Run FontWeight="Bold" Text="{x:Bind TotalCommentNum, Mode=OneWay}" />
                            <Run Text="个观点" />
                        </TextBlock>
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}">
                            <Run FontWeight="Bold" Text="{x:Bind VoteStartTime, Mode=OneWay}" />
                            <Run Text="-" />
                            <Run FontWeight="Bold" Text="{x:Bind VoteEndTime, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <Border
                    Grid.Row="7"
                    Margin="0,4"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ShowSourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <TextBlock
                            x:Uid="/Feed/SourceFeedNotFound"
                            Margin="12,8"
                            HorizontalAlignment="Left"
                            Visibility="{x:Bind EmptySourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <Border Visibility="{x:Bind EmptySourceFeed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                            <controls:WebViewContentControl
                                ContentCornerRadius="{ThemeResource OverlayCornerRadius}"
                                ContentTemplate="{StaticResource SourceFeedDefaultTemplate}"
                                DataContext="{x:Bind SourceFeed, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>
                <Grid
                    Grid.Row="8"
                    Margin="0,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="{x:Bind ExtraTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                    <controls:ImageEx
                        Model="{x:Bind ExtraPic}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Stretch="UniformToFill" />
                    <Grid
                        Padding="8"
                        Tag="{x:Bind ExtraUrl, Mode=OneWay}"
                        Tapped="OnTopTapped"
                        Visibility="{x:Bind ShowLinkSourceFeed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                        <Grid.Background>
                            <AcrylicBrush
                               
                                FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintOpacity="1" />
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Visibility="{x:Bind ExtraPic.Uri, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                            <controls:ImageEx
                                Model="{x:Bind ExtraPic}"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Stretch="UniformToFill" />
                        </Border>
                        <Border
                            Width="56"
                            Height="56"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Visibility="{x:Bind ExtraPic.Uri, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Glyph="&#xE71B;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="8,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                Foreground="White"
                                MaxLines="2"
                                Text="{x:Bind ExtraTitle, Mode=OneWay}"
                                TextTrimming="WordEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ExtraTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Foreground="LightGray"
                                Text="{x:Bind ExtraSubtitle, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ExtraSubtitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid CornerRadius="{ThemeResource OverlayCornerRadius}" Visibility="{x:Bind ShowLinkSourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <Grid.Background>
                            <AcrylicBrush
                               
                                FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintOpacity="1" />
                        </Grid.Background>
                        <controls:WebViewContentControl
                            ContentCornerRadius="{ThemeResource OverlayCornerRadius}"
                            ContentTemplate="{StaticResource SourceFeedDefaultTemplate}"
                            DataContext="{x:Bind LinkSourceFeed, Mode=OneWay}" />
                        <Border Visibility="{x:Bind LinkSourceFeed.Succeed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                            <Border.Child>
                                <muxc:ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsActive="{x:Bind LinkSourceFeed.Succeed, Converter={StaticResource BoolNegationConverter}, ConverterParameter='true', Mode=OneWay}" />
                            </Border.Child>
                        </Border>
                    </Grid>
                </Grid>
                <Grid
                    Grid.Row="9"
                    Margin="0,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="{x:Bind MediaUrl, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                    <controls:ImageEx
                        Model="{x:Bind MediaPic}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Stretch="UniformToFill" />
                    <Grid
                        Padding="8"
                        Tag="{x:Bind MediaUrl, Mode=OneWay}"
                        Tapped="OnTopTapped">
                            <Grid.Background>
                            <AcrylicBrush
                               
                                FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintOpacity="1" />
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Visibility="{x:Bind MediaPic.Uri, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                            <controls:ImageEx
                                Model="{x:Bind MediaPic}"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Stretch="UniformToFill" />
                        </Border>
                        <Border
                            Width="56"
                            Height="56"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Visibility="{x:Bind MediaPic.Uri, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Glyph="&#xE786;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="8,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Uid="/Feed/MediaShare"
                                HorizontalAlignment="Left"
                                MaxLines="2"
                                TextTrimming="WordEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind MediaSubtitle, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind MediaSubtitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <muxc:ItemsRepeaterScrollHost
                    Grid.Row="10"
                    Margin="2,0"
                    Visibility="{x:Bind RelationRows, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <ScrollViewer
                        Padding="0,4"
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Auto"
                        VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource RelationRowsItemTemplate}"
                            ItemsSource="{x:Bind RelationRows, Mode=OneWay}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="6" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </muxc:ItemsRepeaterScrollHost>
                <StackPanel
                    x:Name="ReplyRows"
                    Grid.Row="11"
                    Margin="0,4"
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="{x:Bind ReplyRows, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <muxc:ItemsRepeater
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource ReplyRowsItemTemplate}"
                        ItemsSource="{x:Bind ReplyRows, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                    <TextBlock
                        Margin="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run x:Uid="/Feed/SeeAll" />
                        <Run Text="(" />
                        <Run Text="{x:Bind ReplyNum, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </StackPanel>
                <StackPanel
                    Grid.Row="12"
                    Margin="4"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Visibility="{x:Bind IsQuestionFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Run FontWeight="Bold" Text="{x:Bind QuestionAnswerNum, Mode=OneWay}" />
                        <Run Text="人回答" />
                        <Run Text="•" />
                        <Run FontWeight="Bold" Text="{x:Bind QuestionFollowNum, Mode=OneWay}" />
                        <Run Text="人关注" />
                    </TextBlock>
                    <Border
                        Margin="2,0"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind IsQuestionFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="•"
                            Visibility="{x:Bind IPLocation, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Visibility="{x:Bind IPLocation, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                        <Run x:Uid="/Feed/PublishFrom" />
                        <Run FontWeight="Bold" Text="{x:Bind IPLocation, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="SourceFeedDefaultTemplate" x:DataType="feedmodels:FeedModelBase">
        <UserControl
            x:Name="Root"
            Loaded="UserControl_Loaded"
            SizeChanged="UserControl_SizeChanged"
            Tag="{x:Bind Url, Mode=OneWay}"
            Tapped="OnRootTapped">
            <UserControl.Resources>
                <MenuFlyout x:Key="MoreFlyout">
                    <MenuFlyoutSubItem x:Uid="/Feed/Copy">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                        </MenuFlyoutSubItem.Icon>
                        <ToggleMenuFlyoutItem
                            x:Name="CopyButton"
                            x:Uid="/Feed/CopyFree"
                            IsChecked="{x:Bind IsCopyEnabled, Mode=TwoWay}" />
                        <MenuFlyoutItem
                            x:Uid="/Feed/CopyLink"
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind ShareUrl, Mode=OneWay}" />
                        <MenuFlyoutItem
                            x:Uid="/Feed/CopyAll"
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind Message, Converter={StaticResource HTMLToTextConverter}, Mode=OneWay}" />
                        <MenuFlyoutItem
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='@{0}', Mode=OneWay}"
                            Text="{x:Bind UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='复制 @{0}', Mode=OneWay}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem
                        x:Name="ReportButton"
                        x:Uid="/Feed/Report"
                        Click="FeedButton_Click"
                        Tag="{x:Bind ID, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://m.coolapk.com/mp/do?c=feed&amp;m=report&amp;type=feed&amp;id={0}', Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </UserControl.Resources>
            <Grid
                Padding="8,4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                ContextFlyout="{StaticResource MoreFlyout}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    x:Name="UserBar"
                    Orientation="Horizontal"
                    Visibility="{x:Bind ShowUser, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Button
                        Margin="4"
                        Padding="2"
                        Click="FeedButton_Click"
                        Content="{x:Bind UserInfo.UserName, Mode=OneWay}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind UserInfo.Url, Mode=OneWay}" />
                    <TextBlock
                        Margin="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                        Text="{x:Bind Dateline, Mode=OneWay}" />
                </StackPanel>
                <controls:TextBlockEx
                    x:Name="Message"
                    Grid.Row="1"
                    Margin="4"
                    HorizontalAlignment="Left"
                    IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                    Text="{x:Bind Message, Mode=OneWay}" />
                <GridView
                    Grid.Row="2"
                    MinHeight="0"
                    Margin="4"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    ItemTemplate="{StaticResource PicDefaultTemplate}"
                    ItemsSource="{x:Bind PicArr, Mode=OneWay}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionChanged="GridView_SelectionChanged"
                    Visibility="{x:Bind PicArr, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="FeedReplyDefaultTemplate" x:DataType="feedmodels:FeedReplyModel">
        <UserControl
            x:Name="Root"
            Loaded="UserControl_Loaded"
            SizeChanged="UserControl_SizeChanged">
            <UserControl.Resources>
                <MenuFlyout x:Key="MoreFlyout">
                    <MenuFlyoutSubItem x:Uid="/Feed/Copy">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutSubItem.Icon>
                        <ToggleMenuFlyoutItem
                            x:Name="CopyButton"
                            x:Uid="/Feed/CopyFree"
                            IsChecked="{x:Bind IsCopyEnabled, Mode=TwoWay}" />
                        <MenuFlyoutItem
                            x:Uid="/Feed/CopyAll"
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind Message, Converter={StaticResource HTMLToTextConverter}, Mode=OneWay}" />
                        <MenuFlyoutItem
                            Click="CopyMenuItem_Click"
                            Tag="{x:Bind UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='@{0}', Mode=OneWay}"
                            Text="{x:Bind UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='复制 @{0}', Mode=OneWay}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem
                        x:Name="ReportButton"
                        x:Uid="/Feed/Report"
                        Click="FeedButton_Click"
                        Tag="{x:Bind ID, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://m.coolapk.com/mp/do?c=feed&amp;m=report&amp;type=feed_reply&amp;id={0}', Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8F8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </UserControl.Resources>
            <Grid
                Padding="8,4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                ContextFlyout="{StaticResource MoreFlyout}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    x:Name="UserBar"
                    Grid.Row="1"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,4"
                        Padding="0"
                        Background="{ThemeResource SystemControlTransparentBrush}"
                        Click="Button_Click"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind UserInfo.Url, Mode=OneWay}">
                        <muxc:PersonPicture
                            Width="36"
                            Height="36"
                            DisplayName="{x:Bind UserInfo.UserName, Mode=OneWay}"
                            ProfilePicture="{x:Bind UserInfo.UserAvatar.Pic, Mode=OneWay}" />
                    </Button>
                    <StackPanel Margin="8,0" VerticalAlignment="Center">
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                                Text="{x:Bind UserInfo.UserName, Mode=OneWay}" />
                            <Border
                                Margin="6,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Visibility="{x:Bind IsFeedAuthor, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <TextBlock
                                    x:Uid="/Feed/FeedAuthor"
                                    Margin="1"
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="-1,0" Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                                Text="{x:Bind Dateline, Mode=OneWay}" />
                            <TextBlock
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                                Text="@"
                                Visibility="{x:Bind Rusername, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                            <HyperlinkButton
                                x:Name="Ruser"
                                Margin="0,-5"
                                Click="Button_Click"
                                Content="{x:Bind Rusername, Mode=OneWay}"
                                FontWeight="Normal"
                                Style="{StaticResource TextButtonStyle}"
                                Tag="{x:Bind Rurl, Mode=OneWay}"
                                Visibility="{x:Bind Rusername, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <controls:StackPanel
                    x:Name="BtnsPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        x:Name="LikeButton"
                        x:Uid="/Feed/LikeButton"
                        Height="32"
                        Click="FeedButton_Click"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8E1;"
                                Visibility="{x:Bind Liked, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Glyph="&#xE8E1;"
                                Visibility="{x:Bind Liked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
                            <TextBlock Margin="8,0,0,0" Text="{x:Bind LikeNum, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ReplyButton"
                        x:Uid="/Feed/ReplyButton"
                        Height="32"
                        Click="FeedButton_Click"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE90A;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind ReplyNum, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        x:Uid="/Feed/MoreButton"
                        Height="32"
                        Flyout="{StaticResource MoreFlyout}"
                        Style="{StaticResource TransparentButtonStyle}">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE10C;" />
                    </Button>
                </controls:StackPanel>
                <controls:TextBlockEx
                    x:Name="Message"
                    Grid.Row="3"
                    Margin="4"
                    HorizontalAlignment="Left"
                    IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                    Text="{x:Bind Message, Mode=OneWay}" />
                <GridView
                    Grid.Row="4"
                    MinHeight="0"
                    Margin="4"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    ItemTemplate="{StaticResource PicDefaultTemplate}"
                    ItemsSource="{x:Bind PicArr, Mode=OneWay}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionChanged="GridView_SelectionChanged"
                    Visibility="{x:Bind PicArr, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
                <StackPanel
                    x:Name="ReplyRows"
                    Grid.Row="5"
                    Margin="0,4"
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="{x:Bind ReplyRows, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <ItemsControl
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource ReplyRowsItemTemplate}"
                        ItemsSource="{x:Bind ReplyRows, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button
                        x:Name="SeeAllButton"
                        Padding="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="Button_Click"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="{x:Bind Mode=OneWay}">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run x:Uid="/Feed/SeeAll" />
                            <Run Text="(" />
                            <Run Text="{x:Bind ReplyNum, Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="FeedImageTextTemplate" x:DataType="feedmodels:FeedModel">
        <Grid
            Width="260"
            Height="118"
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Tag="{x:Bind Url, Mode=OneWay}"
            Tapped="OnRootTapped">
            <controls:ImageEx
                Model="{x:Bind Pic}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Stretch="UniformToFill" />
            <Border
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="{x:Bind local:FeedsTemplates.BottomOverlayCornerRadius}"
                Tag="{x:Bind Url, Mode=OneWay}"
                Tapped="OnTopTapped">
                <TextBlock
                    Margin="8"
                    HorizontalAlignment="Left"
                    FontSize="16"
                    Text="{x:Bind MessageTitle, Mode=OneWay}"
                    TextTrimming="WordEllipsis" />
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
