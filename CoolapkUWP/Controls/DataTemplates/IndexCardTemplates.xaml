<ResourceDictionary
    x:Class="CoolapkUWP.Controls.DataTemplates.IndexCardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CoolapkUWP.Models"
    xmlns:users="using:CoolapkUWP.Models.Users"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:templates="using:CoolapkUWP.Controls.DataTemplates"
    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <templates:FeedsTemplates />
        <templates:OtherDataTemplates />
    </ResourceDictionary.MergedDictionaries>

    <templates:ItemTemplateSelector
        x:Key="ItemTemplateSelector"
        Empty="{StaticResource Empty}"
        Feed="{StaticResource FeedDefaultTemplate}"
        FeedImageText="{StaticResource FeedImageTextTemplate}"
        FeedReply="{StaticResource FeedReplyDefaultTemplate}"
        IconLink="{StaticResource IconLinkTemplate}"
        ImageText="{StaticResource ImageTextTemplate}"
        Link="{StaticResource LinkTemplate}"
        List="{StaticResource ListDefaultTemplate}"
        MiniIconLink="{StaticResource MiniIconLinkTemplate}"
        MiniUser="{StaticResource MiniUserTemplate}"
        SquareLinkCard="{StaticResource SquareLinkCardTemplate}"
        SubtitleList="{StaticResource SubtitleListDefaultTemplate}"
        User="{StaticResource ListDefaultTemplate}" />

    <!--  一级卡片  -->

    <DataTemplate x:Key="TitleCardTemplate" x:DataType="models:IndexPageOperationCardModel">
        <Grid
            x:Name="TitleGrid"
            Height="40"
            Margin="12,0"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource SystemControlTransparentBrush}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            <TextBlock
                x:Name="FallbackText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="查看更多"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
            <FontIcon
                x:Name="ForwardSymbol"
                Grid.Column="1"
                Margin="8,0"
                HorizontalAlignment="Right"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="16"
                Glyph="&#xE72A;"
                Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LoginCardTemplate" x:DataType="models:IndexPageOperationCardModel">
        <Grid
            Margin="12,0"
            HorizontalAlignment="Center"
            Background="{ThemeResource SystemControlTransparentBrush}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Margin="8,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="16"
                Glyph="&#xE8FA;" />
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Title, Mode=OneWay}"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RefreshCardTemplate" x:DataType="models:IndexPageOperationCardModel">
        <Grid
            Margin="12,0"
            HorizontalAlignment="Center"
            Background="{ThemeResource SystemControlTransparentBrush}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Margin="8,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="16"
                Glyph="&#xE72C;" />
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Title, Mode=OneWay}"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            <TextBlock
                x:Name="FallbackText"
                x:Uid="/Feed/ClickMeToRefresh"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageCardTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <Grid
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleGrid"
                Grid.Row="0"
                Height="40"
                Margin="12,0"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <FontIcon
                    x:Name="ForwardSymbol"
                    Grid.Column="1"
                    Margin="8,0"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE72A;"
                    Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <Border
                Grid.Row="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <Grid>
                    <FlipView
                        x:Name="FlipView"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource SystemControlTransparentBrush}"
                        ItemsSource="{x:Bind Entities, Mode=OneWay}"
                        Loaded="FlipView_Loaded"
                        SizeChanged="FlipView_SizeChanged">
                        <FlipView.ItemTemplate>
                            <DataTemplate x:DataType="models:IndexPageModel">
                                <Border
                                    x:Name="Picture"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"

                                    KeyDown="Grid_KeyDown"
                                    Tag="{x:Bind Mode=OneWay}"
                                    Tapped="Grid_Tapped">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind Pic.Pic, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>
                    <Border
                        Margin="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        CornerRadius="6"
                        Visibility="{x:Bind Entities, Converter={StaticResource PipsPagerVisibilityConverter}, Mode=OneWay}">
                            <Border.Background>
                            <AcrylicBrush
                               
                                FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintOpacity="0" />
                        </Border.Background>
                        <muxc:PipsPager
                            Margin="2,0"
                            NumberOfPages="{x:Bind Entities, Converter={StaticResource CollectionCountConverter}, Mode=OneWay}"
                            SelectedPageIndex="{x:Bind FlipView.SelectedIndex, Mode=TwoWay}" />
                    </Border>
                </Grid>
            </Border>
            <Border
                Grid.Row="2"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Tag="{x:Bind Mode=OneWay}"
                Tapped="Grid_Tapped"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                <Image
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    CanDrag="True"
                    Source="{x:Bind Pic.Pic, Mode=OneWay}" />
            </Border>
            <Border
                x:Name="SubTitleBorder"
                Grid.Row="3"
                Margin="12,8"
                VerticalAlignment="Stretch"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                <control:TextBlockEx Text="{x:Bind Description, Mode=OneWay}" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IconLinksTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <Border
            Margin="8"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource SystemControlTransparentBrush}"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <muxc:ItemsRepeater
                x:Name="EntitiesRepeater"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind Entities, Mode=OneWay}">
                <muxc:ItemsRepeater.Layout>
                    <primitives:ColumnMajorUniformToLargestGridLayout
                        ColumnSpacing="8"
                        MaxColumns="2147483647"
                        RowSpacing="8" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:IndexPageModel">
                        <Button
                            x:Name="Root"
                            MinWidth="64"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource SystemControlTransparentBrush}"
                            Click="Button_Click"
                            Style="{ThemeResource TransparentButtonStyle}"
                            Tag="{x:Bind Mode=OneWay}">
                            <control:StackPanel HorizontalAlignment="Stretch" Spacing="2">
                                <Border
                                    Width="40"
                                    Height="40"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <Image Source="{x:Bind Pic.Pic, Mode=OneWay}" />
                                </Border>
                                <TextBlock
                                    x:Name="TitleText"
                                    HorizontalAlignment="Center"
                                    MaxLines="1"
                                    Text="{x:Bind Title, Mode=OneWay}" />
                            </control:StackPanel>
                        </Button>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MessageCardTemplate" x:DataType="models:IndexPageMessageCardModel">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <control:TextBlockEx
                    x:Name="Description"
                    Grid.Row="1"
                    Text="{x:Bind Description, Mode=OneWay}"
                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <muxc:ItemsRepeaterScrollHost
                x:Name="EntitiesHost"
                Grid.Row="1"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ScrollViewer
                    Padding="8"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollMode="Disabled">
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource ItemTemplateSelector}" ItemsSource="{x:Bind Entities, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Orientation="Horizontal" Spacing="8" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </muxc:ItemsRepeaterScrollHost>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GridScrollCardTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleGrid"
                Grid.Row="0"
                Height="40"
                Margin="12,0"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                Tag="{x:Bind Mode=OneWay}"
                Tapped="Grid_Tapped"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <TextBlock
                    x:Name="FallbackText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="查看更多"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
                <FontIcon
                    x:Name="ForwardSymbol"
                    Grid.Column="1"
                    Margin="8,0"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE72A;"
                    Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <Border
                Grid.Row="1"
                Height="8"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind ShowTitle, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
            <muxc:ItemsRepeater
                Grid.Row="2"
                Margin="8,0,8,8"
                HorizontalAlignment="Left"
                ItemTemplate="{StaticResource ItemTemplateSelector}"
                ItemsSource="{x:Bind Entities, Mode=OneWay}"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <muxc:ItemsRepeater.Layout>
                    <primitives:ColumnMajorUniformToLargestGridLayout
                        ColumnSpacing="8"
                        MaxColumns="2147483647"
                        RowSpacing="8" />
                </muxc:ItemsRepeater.Layout>
            </muxc:ItemsRepeater>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageTextScrollCardTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleGrid"
                Grid.Row="0"
                Height="40"
                Margin="12,0"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                Tag="{x:Bind Mode=OneWay}"
                Tapped="Grid_Tapped"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <TextBlock
                    x:Name="FallbackText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="查看更多"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
                <FontIcon
                    x:Name="ForwardSymbol"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE72A;"
                    Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <Border
                Grid.Row="1"
                Height="8"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind ShowTitle, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
            <muxc:ItemsRepeaterScrollHost
                x:Name="EntitiesHost"
                Grid.Row="2"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ScrollViewer
                    Padding="8,0,8,8"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollMode="Disabled">
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource ItemTemplateSelector}" ItemsSource="{x:Bind Entities, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Orientation="Horizontal" Spacing="8" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </muxc:ItemsRepeaterScrollHost>
        </Grid>
    </DataTemplate>

    <!--  二级卡片  -->

    <DataTemplate x:Key="SquareLinkCardTemplate" x:DataType="models:IndexPageModel">
        <Border
            Width="86"
            Height="86"
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Border.Background>
                <ImageBrush ImageSource="{x:Bind Pic.Pic, Mode=OneWay}" Stretch="UniformToFill" />
            </Border.Background>
            <Grid
                Padding="4"
                VerticalAlignment="Bottom"
                CornerRadius="0,0,8,8"
                Tag="{x:Bind Mode=OneWay}"
                Tapped="Grid_Tapped">
                    <Grid.Background>
                    <AcrylicBrush
                       
                        FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintOpacity="1" />
                </Grid.Background>
                <TextBlock
                    Margin="2"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    MaxLines="1"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="IconLinkTemplate" x:DataType="models:IndexPageModel">
        <Border
            Width="86"
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Border.Background>
                <ImageBrush ImageSource="{x:Bind Pic.Pic, Mode=OneWay}" Stretch="UniformToFill" />
            </Border.Background>
            <StackPanel Padding="4" CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel.Background>
                    <AcrylicBrush
                       
                        FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintOpacity="1" />
                </StackPanel.Background>
                <Border
                    Width="36"
                    Height="36"
                    Margin="4"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Tag="{x:Bind Mode=OneWay}"
                    Tapped="Grid_Tapped">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind Pic.Pic, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    MaxLines="1"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SubTitle"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind SubTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind SubTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LinkTemplate" x:DataType="models:IndexPageModel">
        <Grid
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Border CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Image
                    MaxWidth="160"
                    MaxHeight="65"
                    Source="{x:Bind Pic.Pic, Mode=OneWay}"
                    Stretch="UniformToFill" />
            </Border>
            <Border
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                <TextBlock
                    Margin="8,0"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageTextTemplate" x:DataType="models:IndexPageModel">
        <Grid
            Width="260"
            Height="118"
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind Mode=OneWay}"
            Tapped="Grid_Tapped">
            <Grid.Background>
                <ImageBrush ImageSource="{x:Bind Pic.Pic, Mode=OneWay}" />
            </Grid.Background>
            <Border
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="{x:Bind templates:IndexCardTemplates.BottomOverlayCornerRadius}">
                <TextBlock
                    Margin="8"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="WordEllipsis" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MiniUserTemplate" x:DataType="users:UserModel">
        <Button
            Width="86"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Click="Button_Click"
            Style="{ThemeResource TransparentButtonStyle}"
            Tag="{x:Bind Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Ellipse
                    Grid.Row="0"
                    Width="36"
                    Height="36"
                    Margin="8"
                    HorizontalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{x:Bind Pic.Pic, Mode=OneWay}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="MiniIconLinkTemplate" x:DataType="models:IHasDescription">
        <Button
            Width="124"
            MinHeight="0"
            Padding="0"
            HorizontalContentAlignment="Left"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Click="Button_Click"
            Style="{ThemeResource TransparentButtonStyle}"
            Tag="{x:Bind Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    Margin="8"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind Pic.Pic, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
