<Page
    x:Class="CoolapkUWP.Pages.FeedPages.FeedListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:feedpages="using:CoolapkUWP.ViewModels.FeedPages"
    xmlns:local="using:CoolapkUWP.Pages.FeedPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:CoolapkUWP.Models.Pages"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:images="using:CoolapkUWP.Models.Images"
    xmlns:users="using:CoolapkUWP.Models.Users"
    xmlns:templates="using:CoolapkUWP.Controls.DataTemplates"
    xmlns:ui="using:CommunityToolkit.WinUI"
    d:DataContext="{d:DesignInstance Type=feedpages:FeedListViewModel}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:FeedsTemplates />
                <templates:IndexCardTemplates />
                <templates:OtherDataTemplates />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="UserDetailCard" x:DataType="pages:UserDetail">
                <Border>
                    <Border.Resources>
                        <MenuFlyout x:Key="MoreFlyout">
                            <MenuFlyoutItem
                                x:Name="PinTileButton"
                                x:Uid="/FeedListPage/PinTile"
                                Click="Button_Click"
                                Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE840;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Name="ReportButton"
                                x:Uid="/FeedListPage/Report"
                                Click="Button_Click"
                                Tag="{x:Bind UID, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://m.coolapk.com/mp/do?c=user&amp;m=report&amp;id={0}', Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Uid="/FeedListPage/CoverMenuSubItem">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B9;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem
                                    x:Name="RefreshButton"
                                    x:Uid="/FeedListPage/RefreshMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ShowImageButton"
                                    x:Uid="/FeedListPage/ShowMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="CopyButton"
                                    x:Uid="/FeedListPage/CopyMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ShareButton"
                                    x:Uid="/FeedListPage/ShareMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="SaveButton"
                                    x:Uid="/FeedListPage/SaveMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Border.Resources>
                    <Grid
                        HorizontalAlignment="Stretch"
                        CanDrag="True"
                        ContextFlyout="{StaticResource MoreFlyout}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        DragStarting="Image_DragStarting">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="174" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <control:ImageEx
                            Height="132"
                            VerticalAlignment="Top"
                            Model="{x:Bind Cover}"
                            Stretch="UniformToFill" />
                        <Grid
                            Margin="16,8,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="FollowButton"
                                Height="36"
                                MinWidth="88"
                                Padding="16,0"
                                Click="Button_Click"
                                Content="{x:Bind FollowStatus, Mode=OneWay}"
                                CornerRadius="18"
                                FontSize="15"
                                Style="{StaticResource CoolapkAccentButtonStyle}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind ShowFollowButton, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            <Button
                                x:Name="MessageButton"
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Click="Button_Click"
                                CornerRadius="18"
                                Style="{StaticResource CoolapkAccentButtonStyle}"
                                Tag="{x:Bind UID, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://m.coolapk.com/mp/message/chat?uid={0}', Mode=OneWay}"
                                ToolTipService.ToolTip="私信"
                                Visibility="{x:Bind ShowFollowButton, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Foreground="White"
                                    Glyph="&#xE715;" />
                            </Button>
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Margin="0,-42,0,0"
                            Padding="16,48,16,16"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <control:StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                                        Text="{x:Bind UserName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="#FFFF8A3D"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind LevelText, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="{x:Bind IsCopyEnabled, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ShowVerify, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <Run
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Foreground="{ThemeResource CoolapkAccentBrush}"
                                        Text="&#xE10B;" />
                                    <Run Text="{x:Bind VerifyTitle, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Bio, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ShowBio, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                <control:StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock FontSize="15">
                                        <Run FontWeight="SemiBold" Text="{x:Bind LikeNum, Mode=OneWay}" />
                                        <Run x:Uid="/FeedListPage/LikeNum" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <Button
                                        x:Name="FollowsButton"
                                        Padding="0"
                                        Click="Button_Click"
                                        FontSize="15"
                                        Style="{StaticResource TransparentButtonStyle}">
                                        <TextBlock>
                                            <Run FontWeight="SemiBold" Text="{x:Bind FollowNum, Mode=OneWay}" />
                                            <Run x:Uid="/FeedListPage/FollowNum" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </Button>
                                    <Button
                                        x:Name="FansButton"
                                        Padding="0"
                                        Click="Button_Click"
                                        FontSize="15"
                                        Style="{StaticResource TransparentButtonStyle}">
                                        <TextBlock>
                                            <Run FontWeight="SemiBold" Text="{x:Bind FansNum, Mode=OneWay}" />
                                            <Run x:Uid="/FeedListPage/FansNum" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </Button>
                                </control:StackPanel>
                                <control:StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource CoolapkAccentBrush}"
                                        Glyph="&#xE13D;"
                                        Visibility="{x:Bind ShowGender, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Gender, Mode=OneWay}"
                                        Visibility="{x:Bind ShowGender, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind LoginTime, Mode=OneWay}"
                                        Visibility="{x:Bind ShowLoginTime, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind City, Mode=OneWay}"
                                        Visibility="{x:Bind City, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Astro, Mode=OneWay}"
                                        Visibility="{x:Bind Astro, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind BlockStatus, Mode=OneWay}"
                                        Visibility="{x:Bind BlockStatus, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                                </control:StackPanel>
                            </control:StackPanel>
                        </Border>
                        <Border
                            Width="84"
                            Height="84"
                            Margin="16,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderThickness="3"
                            Canvas.ZIndex="1"
                            CornerRadius="42">
                            <control:ImageEx
                                Model="{x:Bind UserAvatar, Mode=OneWay}"
                                CornerRadius="39"
                                Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="TopicDetailCard" x:DataType="pages:TopicDetail">
                <Border
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Border.Resources>
                        <MenuFlyout x:Key="MoreFlyout">
                            <MenuFlyoutItem
                                x:Name="PinTileButton"
                                x:Uid="/FeedListPage/PinTile"
                                Click="Button_Click"
                                Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE840;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.Resources>
                    <control:StackPanel
                        Background="{ThemeResource SystemControlTransparentBrush}"
                        ContextFlyout="{StaticResource MoreFlyout}"
                        Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <control:ImageEx
                                        Model="{x:Bind Logo}"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                                        Stretch="UniformToFill" />
                                </Border>
                            <control:StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind HotNum, Mode=OneWay}" />
                                    <Run Text="{x:Bind CommentNum, Mode=OneWay}" />
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <muxc:ItemsRepeater ItemsSource="{x:Bind FollowUsers, Mode=OneWay}">
                                        <muxc:ItemsRepeater.Layout>
                                            <muxc:StackLayout Orientation="Horizontal" Spacing="-6" />
                                        </muxc:ItemsRepeater.Layout>
                                        <muxc:ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="users:UserModel">
                                                <Border
                                                    Width="16"
                                                    Height="16"
                                                    CornerRadius="8"
                                                    Tag="{x:Bind Url, Mode=OneWay}"
                                                    Tapped="On_Tapped"
                                                    ToolTipService.ToolTip="{x:Bind UserName, Mode=OneWay}">
                                                    <control:ImageEx
                                                        Model="{x:Bind UserAvatar, Mode=OneWay}"
                                                        CornerRadius="8"
                                                        Stretch="Fill" />
                                                </Border>
                                            </DataTemplate>
                                        </muxc:ItemsRepeater.ItemTemplate>
                                    </muxc:ItemsRepeater>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0"
                                        FontSize="12"
                                        Text="{x:Bind FollowNum, Mode=OneWay}" />
                                </Grid>
                            </control:StackPanel>
                            <Button
                                x:Name="FollowButton"
                                Grid.Column="2"
                                Height="32"
                                HorizontalAlignment="Right"
                                Click="Button_Click"
                                Style="{StaticResource TransparentButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind FollowStatus, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="15"
                                        Glyph="{x:Bind FollowGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        x:Name="FollowStatus"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind FollowStatus, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            Text="{x:Bind Description, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind SubTitle, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind SubTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    </control:StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="DyhDetailCard" x:DataType="pages:DyhDetail">
                <Border
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Border.Resources>
                        <MenuFlyout x:Key="MoreFlyout">
                            <MenuFlyoutItem
                                x:Name="PinTileButton"
                                x:Uid="/FeedListPage/PinTile"
                                Click="Button_Click"
                                Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE840;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.Resources>
                    <control:StackPanel
                        Background="{ThemeResource SystemControlTransparentBrush}"
                        ContextFlyout="{StaticResource MoreFlyout}"
                        Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <control:ImageEx
                                        Model="{x:Bind Logo}"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                                        Stretch="UniformToFill" />
                                </Border>
                            <control:StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Thin"
                                    Text="{x:Bind FollowNum, Mode=OneWay}" />
                                <Grid
                                    Background="{ThemeResource SystemControlTransparentBrush}"
                                    Tag="{x:Bind Uurl, Mode=OneWay}"
                                    Tapped="On_Tapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="16" Height="16" CornerRadius="8">
                                        <control:ImageEx
                                            Model="{x:Bind UserAvatar, Mode=OneWay}"
                                            CornerRadius="8"
                                            Stretch="Fill" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0"
                                        FontSize="12"
                                        Text="{x:Bind UserName, Mode=OneWay}" />
                                </Grid>
                            </control:StackPanel>
                            <Button
                                x:Name="FollowButton"
                                Grid.Column="2"
                                Height="32"
                                HorizontalAlignment="Right"
                                Click="Button_Click"
                                Style="{StaticResource TransparentButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind FollowStatus, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="15"
                                        Glyph="{x:Bind FollowGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        x:Name="FollowStatus"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind FollowStatus, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            Text="{x:Bind Description, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    </control:StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ProductDetailCard" x:DataType="pages:ProductDetail">
                <control:StackPanel Spacing="6">
                    <Grid
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind CoverArr, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                        <FlipView
                            x:Name="FlipView"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Background="{ThemeResource SystemControlTransparentBrush}"
                            ItemsSource="{x:Bind CoverArr, Mode=OneWay}"
                            Loaded="FlipView_Loaded"
                            SizeChanged="FlipView_SizeChanged">
                            <FlipView.ItemTemplate>
                                <DataTemplate x:DataType="images:ImageModel">
                                    <control:ImageEx
                                        x:Name="Picture"
                                        CanDrag="True"
                                        DragStarting="Image_DragStarting"
                                        Model="{x:Bind}"
                                        Stretch="UniformToFill"
                                        Tag="{x:Bind}">
                                        <control:ImageEx.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Name="RefreshButton"
                                                    x:Uid="/FeedListPage/RefreshMenuItem"
                                                    Click="AppBarButton_Click"
                                                    Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Name="CopyButton"
                                                    x:Uid="/FeedListPage/CopyMenuItem"
                                                    Click="AppBarButton_Click"
                                                    Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Name="ShareButton"
                                                    x:Uid="/FeedListPage/ShareMenuItem"
                                                    Click="AppBarButton_Click"
                                                    Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Name="SaveButton"
                                                    x:Uid="/FeedListPage/SaveMenuItem"
                                                    Click="AppBarButton_Click"
                                                    Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74E;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </control:ImageEx.ContextFlyout>
                                    </control:ImageEx>
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>
                        <Border
                            Margin="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            CornerRadius="6">
                            <muxc:PipsPager
                                Margin="2,0"
                                NumberOfPages="{x:Bind CoverArr, Converter={StaticResource CollectionCountConverter}, Mode=OneWay}"
                                SelectedPageIndex="{x:Bind FlipView.SelectedIndex, Mode=TwoWay}" />
                        </Border>
                    </Grid>
                    <Grid
                        Padding="10"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <control:StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Left"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <control:ImageEx
                                    Model="{x:Bind Logo}"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Stretch="UniformToFill" />
                            </Border>
                                <control:StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title, Mode=OneWay}" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind HotNum, Mode=OneWay}" />
                                        <Run Text="{x:Bind CommentNum, Mode=OneWay}" />
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <muxc:ItemsRepeater ItemsSource="{x:Bind FollowUsers, Mode=OneWay}">
                                            <muxc:ItemsRepeater.Layout>
                                                <muxc:StackLayout Orientation="Horizontal" Spacing="-6" />
                                            </muxc:ItemsRepeater.Layout>
                                            <muxc:ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="users:UserModel">
                                                    <Border
                                                        Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        Tag="{x:Bind Url, Mode=OneWay}"
                                                        Tapped="On_Tapped"
                                                        ToolTipService.ToolTip="{x:Bind UserName, Mode=OneWay}">
                                                        <control:ImageEx
                                                            Model="{x:Bind UserAvatar, Mode=OneWay}"
                                                            CornerRadius="8"
                                                            Stretch="Fill" />
                                                    </Border>
                                                </DataTemplate>
                                            </muxc:ItemsRepeater.ItemTemplate>
                                        </muxc:ItemsRepeater>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="4,0"
                                            FontSize="12"
                                            Text="{x:Bind FollowNum, Mode=OneWay}" />
                                    </Grid>
                                </control:StackPanel>
                                <Button
                                    x:Name="FollowButton"
                                    Grid.Column="2"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Click="Button_Click"
                                    Style="{StaticResource TransparentButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind FollowStatus, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="15"
                                            Glyph="{x:Bind FollowGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            x:Name="FollowStatus"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind FollowStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock
                                Text="{x:Bind Description, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        </control:StackPanel>
                    </Grid>
                    <muxc:ItemsRepeaterScrollHost Visibility="{x:Bind TagArr, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                        <ScrollViewer
                            Margin="0,-2"
                            Padding="0,2"
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Auto"
                            VerticalScrollMode="Disabled">
                            <muxc:ItemsRepeater HorizontalAlignment="Stretch" ItemsSource="{x:Bind TagArr, Mode=OneWay}">
                                <muxc:ItemsRepeater.Layout>
                                    <muxc:StackLayout Orientation="Horizontal" Spacing="6" />
                                </muxc:ItemsRepeater.Layout>
                                <muxc:ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <TextBlock
                                                Margin="4,2"
                                                FontSize="12"
                                                Text="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </muxc:ItemsRepeater.ItemTemplate>
                            </muxc:ItemsRepeater>
                        </ScrollViewer>
                    </muxc:ItemsRepeaterScrollHost>
                    <Grid
                        Padding="10"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <control:StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Uid="/FeedListPage/OwnerStar"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Visibility="{x:Bind OnlyOwnerButton.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock
                                    x:Uid="/FeedListPage/AllStar"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Visibility="{x:Bind SeeAllButton.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Grid Grid.Column="1" HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton
                                        x:Name="SeeAllButton"
                                        x:Uid="/FeedListPage/SeeAllButton"
                                        Grid.Column="1"
                                        Padding="4,2"

                                        CornerRadius="{x:Bind local:FeedListPage.RightControlCornerRadius}"
                                        BorderThickness="0,1,1,1"
                                        FontSize="12"
                                        IsChecked="{x:Bind OnlyOwnerButton.IsChecked, Converter={StaticResource BoolNegationConverter}, Mode=TwoWay}" />
                                    <ToggleButton
                                        x:Name="OnlyOwnerButton"
                                        x:Uid="/FeedListPage/OnlyOwnerButton"
                                        Grid.Column="0"
                                        Padding="4,2"

                                        CornerRadius="{x:Bind local:FeedListPage.LeftControlCornerRadius}"
                                        BorderThickness="1,1,0,1"
                                        FontSize="12"
                                        IsChecked="{x:Bind SeeAllButton.IsChecked, Converter={StaticResource BoolNegationConverter}, Mode=TwoWay}" />
                                </Grid>
                            </Grid>
                            <Grid Height="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center" Visibility="{x:Bind OnlyOwnerButton.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="35"
                                        FontWeight="Bold"
                                        Text="{x:Bind OwnerScore, Mode=OneWay}" />
                                    <muxc:RatingControl
                                        HorizontalAlignment="Center"
                                        IsReadOnly="True"
                                        Value="{x:Bind OwnerScore, Converter={StaticResource NumMultConverter}, ConverterParameter='0.5', Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Thin"
                                        Text="{x:Bind RatingCount, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" Visibility="{x:Bind SeeAllButton.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="35"
                                        FontWeight="Bold"
                                        Text="{x:Bind RatingScore, Mode=OneWay}" />
                                    <muxc:RatingControl
                                        HorizontalAlignment="Center"
                                        IsReadOnly="True"
                                        Value="{x:Bind RatingScore, Converter={StaticResource NumMultConverter}, ConverterParameter='0.5', Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Thin"
                                        Text="{x:Bind StarCount, Mode=OneWay}" />
                                </StackPanel>
                                <Grid
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind OnlyOwnerButton.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="5星" />
                                    <muxc:ProgressBar
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind OwnerStar5Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind OwnerStar5Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="4星" />
                                    <muxc:ProgressBar
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind OwnerStar4Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind OwnerStar4Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="3星" />
                                    <muxc:ProgressBar
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind OwnerStar3Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind OwnerStar3Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="2星" />
                                    <muxc:ProgressBar
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind OwnerStar2Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind OwnerStar2Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="1星" />
                                    <muxc:ProgressBar
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind OwnerStar1Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind OwnerStar1Count, Mode=OneWay}" />
                                </Grid>
                                <Grid
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind SeeAllButton.IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="5星" />
                                    <muxc:ProgressBar
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind Star5Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind Star5Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="4星" />
                                    <muxc:ProgressBar
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind Star4Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind Star4Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="3星" />
                                    <muxc:ProgressBar
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind Star3Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind Star3Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="2星" />
                                    <muxc:ProgressBar
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind Star2Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind Star2Count, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="1星" />
                                    <muxc:ProgressBar
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Value="{x:Bind Star1Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        FontSize="10"
                                        FontWeight="Thin"
                                        Text="{x:Bind Star1Count, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </control:StackPanel>
                    </Grid>
                </control:StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="CollectionDetailCard" x:DataType="pages:CollectionDetail">
                <Grid
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid.Resources>
                        <MenuFlyout x:Key="MoreFlyout">
                            <MenuFlyoutItem
                                x:Name="PinTileButton"
                                x:Uid="/FeedListPage/PinTile"
                                Click="Button_Click"
                                Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE840;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Uid="/FeedListPage/CoverMenuSubItem">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B9;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem
                                    x:Name="RefreshButton"
                                    x:Uid="/FeedListPage/RefreshMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ShowImageButton"
                                    x:Uid="/FeedListPage/ShowMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="CopyButton"
                                    x:Uid="/FeedListPage/CopyMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ShareButton"
                                    x:Uid="/FeedListPage/ShareMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="SaveButton"
                                    x:Uid="/FeedListPage/SaveMenuItem"
                                    Click="AppBarButton_Click"
                                    Tag="{x:Bind Cover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Grid.Resources>
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CanDrag="True"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        DragStarting="Image_DragStarting">
                        <control:ImageEx
                            ContextFlyout="{StaticResource MoreFlyout}"
                            Model="{x:Bind Cover}"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Stretch="UniformToFill"
                            Tag="{x:Bind Cover, Mode=OneWay}" />
                    </Border>
                    <Grid
                        Padding="8"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        CornerRadius="0,0,8,8">
                        <control:StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="20"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="LikeButton"
                                        x:Uid="/FeedListPage/LikeButton"
                                        Height="32"
                                        Click="Button_Click"
                                        Style="{StaticResource TransparentButtonStyle}"
                                        Tag="{x:Bind}">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE8E1;"
                                                Visibility="{x:Bind Liked, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                Glyph="&#xE8E1;"
                                                Visibility="{x:Bind Liked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
                                            <TextBlock Margin="8,0,0,0" Text="{x:Bind LikeNum, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="FollowButton"
                                        Height="32"
                                        Click="Button_Click"
                                        Style="{StaticResource TransparentButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind FollowStatus, Mode=OneWay}"
                                        Visibility="{x:Bind FollowStatus, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="15"
                                                Glyph="{x:Bind FollowGlyph, Mode=OneWay}" />
                                            <TextBlock
                                                x:Name="FollowStatus"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind FollowStatus, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    CornerRadius="10">
                                    <control:ImageEx
                                        Model="{x:Bind UserAvatar}"
                                        CornerRadius="10"
                                        Stretch="Fill" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="0,0,0,2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="{x:Bind UserName, Mode=OneWay}" />
                                    <Run Text="{x:Bind LastUpdate, Mode=OneWay}" />
                                    <Run Text="{x:Bind FollowNum, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <TextBlock
                                Text="{x:Bind Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        </control:StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>
            <templates:CardTemplateSelector
                x:Key="CardTemplateSelector"
                ColorfulScrollCard="{StaticResource ColorfulScrollCardTemplate}"
                CapsuleListCard="{StaticResource CapsuleListCardTemplate}"
                ArticleNewsSingle="{StaticResource ArticleNewsSingleTemplate}"
                ArticleNewsMulti="{StaticResource ArticleNewsMultiTemplate}"
                Feed="{StaticResource FeedDefaultTemplate}"
                FeedCover="{StaticResource FeedCoverTemplate}"
                FeedListCard="{StaticResource FeedListCardTemplate}"
                FeedReply="{StaticResource FeedReplyDefaultTemplate}"
                GridScrollCard="{StaticResource GridScrollCardTemplate}"
                IconGridCard="{StaticResource IconGridCardTemplate}"
                IconLinks="{StaticResource IconLinksTemplate}"
                IconListCard="{StaticResource IconListCardTemplate}"
                IconLongTitleGridCard="{StaticResource IconLongTitleGridCardTemplate}"
                IconMiniGridCard="{StaticResource IconMiniGridCardTemplate}"
                IconMiniScrollCard="{StaticResource IconMiniScrollCardTemplate}"
                ImageScaleCard="{StaticResource ImageScaleCardTemplate}"
                SelectorLinkCard="{StaticResource SelectorLinkCardTemplate}"
                ImageTextScrollCard="{StaticResource ImageTextScrollCardTemplate}"
                Images="{StaticResource ImageCardTemplate}"
                List="{StaticResource ListDefaultTemplate}"
                ListCard="{StaticResource ListCardTemplate}"
                Others="{StaticResource Empty}"
                ProductTimelineListCard="{StaticResource ProductTimelineListCardTemplate}"
                Rating="{StaticResource IconListFeedItemRatingTemplate}"
                SortSelectCard="{StaticResource SortSelectCardTemplate}"
                User="{StaticResource UserTemplate}" />
            <templates:DetailTemplateSelector
                x:Key="DetailTemplateSelector"
                CollectionDetail="{StaticResource CollectionDetailCard}"
                DyhDetail="{StaticResource DyhDetailCard}"
                Others="{StaticResource Empty}"
                ProductDetail="{StaticResource ProductDetailCard}"
                TopicDetail="{StaticResource TopicDetailCard}"
                UserDetail="{StaticResource UserDetailCard}" />
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <control:PageHeader
            x:Name="HeaderControl"
            Title="{x:Bind Provider.Title, Mode=OneWay}"
            Margin="18,0,0,0"
            FontSize="{StaticResource ContentControlFontSize}"
            FontWeight="Normal">
            <Button
                x:Name="HeaderRefreshButton"
                x:Uid="/FeedListPage/RefreshButton"
                VerticalAlignment="Center"
                Click="RefreshButton_Click"
                Content="&#xE72C;"
                Style="{StaticResource NavigationIconButtonNormalStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
        </control:PageHeader>
        <control:ShyHeaderListView
            x:Name="ListView"
            Grid.Row="1"
            Padding="7,3,7,4"
            ui:ListViewExtensions.ItemContainerStretchDirection="Horizontal"
            HeaderHeight="42"
            ItemContainerStyle="{StaticResource DefaultCardItemStyle}"
            ItemTemplateSelector="{StaticResource CardTemplateSelector}"
            ShowsScrollingPlaceholders="False"
            ShyHeaderItemSource="{x:Bind Provider.ItemSource, Mode=OneWay}"
            ShyHeaderSelectedIndex="{x:Bind Provider.SelectedTabIndex, Mode=OneWay}">
            <control:ShyHeaderListView.TopHeader>
                <ContentControl
                    x:Name="DetailControl"
                    Margin="5,1,5,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Content="{x:Bind Provider.Detail, Mode=OneWay}" />
            </control:ShyHeaderListView.TopHeader>
        </control:ShyHeaderListView>
    </Grid>
</Page>
