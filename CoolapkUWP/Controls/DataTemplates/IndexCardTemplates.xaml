<ResourceDictionary
    x:Class="CoolapkUWP.Controls.DataTemplates.IndexCardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CoolapkUWP.Models"
    xmlns:feedmodels="using:CoolapkUWP.Models.Feeds"
    xmlns:users="using:CoolapkUWP.Models.Users"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:templates="using:CoolapkUWP.Controls.DataTemplates"
    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <templates:FeedsTemplates />
        <templates:OtherDataTemplates />
    </ResourceDictionary.MergedDictionaries>

    <templates:ItemTemplateSelector
        x:Key="ItemTemplateSelector"
        Empty="{StaticResource Empty}"
        Feed="{StaticResource FeedDefaultTemplate}"
        FeedImageText="{StaticResource FeedImageTextTemplate}"
        FeedReply="{StaticResource FeedReplyDefaultTemplate}"
        IconLink="{StaticResource IconLinkTemplate}"
        ImageText="{StaticResource ImageTextTemplate}"
        Link="{StaticResource LinkTemplate}"
        List="{StaticResource ListDefaultTemplate}"
        MiniIconLink="{StaticResource MiniIconLinkTemplate}"
        MiniUser="{StaticResource MiniUserTemplate}"
        SquareLinkCard="{StaticResource SquareLinkCardTemplate}"
        SubtitleList="{StaticResource SubtitleListDefaultTemplate}"
        User="{StaticResource ListDefaultTemplate}" />

    <templates:IconListItemSelector
        x:Key="IconListItemSelector"
        Feed="{StaticResource IconListFeedItemTemplate}"
        Icon="{StaticResource IconListItemTemplate}"
        List="{StaticResource ListDefaultTemplate}"
        User="{StaticResource UserTemplate}" />

    <!--  一级卡片  -->

    <DataTemplate x:Key="TitleCardTemplate" x:DataType="models:IndexPageOperationCardModel">
        <Grid
            x:Name="TitleGrid"
            Height="40"
            Margin="12,0"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource SystemControlTransparentBrush}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            <TextBlock
                x:Name="FallbackText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="查看更多"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
            <FontIcon
                x:Name="ForwardSymbol"
                Grid.Column="1"
                Margin="8,0"
                HorizontalAlignment="Right"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="16"
                Glyph="&#xE72A;"
                Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LoginCardTemplate" x:DataType="models:IndexPageOperationCardModel">
        <Grid
            Margin="12,0"
            HorizontalAlignment="Center"
            Background="{ThemeResource SystemControlTransparentBrush}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Margin="8,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="16"
                Glyph="&#xE8FA;" />
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Title, Mode=OneWay}"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RefreshCardTemplate" x:DataType="models:IndexPageOperationCardModel">
        <Grid
            Margin="12,0"
            HorizontalAlignment="Center"
            Background="{ThemeResource SystemControlTransparentBrush}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Margin="8,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="16"
                Glyph="&#xE72C;" />
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Title, Mode=OneWay}"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            <TextBlock
                x:Name="FallbackText"
                x:Uid="/Feed/ClickMeToRefresh"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, ConverterParameter='true', Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageCardTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <Grid
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleGrid"
                Grid.Row="0"
                Height="40"
                Margin="12,0"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <FontIcon
                    x:Name="ForwardSymbol"
                    Grid.Column="1"
                    Margin="8,0"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE72A;"
                    Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <Border
                Grid.Row="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <Grid>
                    <FlipView
                        x:Name="FlipView"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource SystemControlTransparentBrush}"
                        ItemsSource="{x:Bind Entities, Mode=OneWay}"
                        Loaded="FlipView_Loaded"
                        SizeChanged="FlipView_SizeChanged">
                        <FlipView.ItemTemplate>
                            <DataTemplate x:DataType="models:IndexPageModel">
                                <Border
                                    x:Name="Picture"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"

                                    KeyDown="Grid_KeyDown"
                                    Tag="{x:Bind}"
                                    Tapped="Grid_Tapped">
                                    <control:ImageEx Model="{x:Bind Pic}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>
                    <Border
                        Margin="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        CornerRadius="6"
                        Visibility="{x:Bind Entities, Converter={StaticResource PipsPagerVisibilityConverter}, Mode=OneWay}">
                            <Border.Background>
                            <AcrylicBrush
                               
                                FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintColor="{ThemeResource SystemChromeMediumHighColor}"
                                TintOpacity="0" />
                        </Border.Background>
                        <muxc:PipsPager
                            Margin="2,0"
                            NumberOfPages="{x:Bind Entities, Converter={StaticResource CollectionCountConverter}, Mode=OneWay}"
                            SelectedPageIndex="{Binding SelectedIndex, ElementName=FlipView, Mode=TwoWay}" />
                    </Border>
                </Grid>
            </Border>
            <Border
                Grid.Row="2"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Tag="{x:Bind}"
                Tapped="Grid_Tapped"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                <control:ImageEx
                    Model="{x:Bind Pic}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="Uniform" />
            </Border>
            <Border
                x:Name="SubTitleBorder"
                Grid.Row="3"
                Margin="12,8"
                VerticalAlignment="Stretch"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                <control:TextBlockEx Text="{x:Bind Description, Mode=OneWay}" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IconLinksTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <Border
            Margin="8"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource SystemControlTransparentBrush}"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <muxc:ItemsRepeater
                x:Name="EntitiesRepeater"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind Entities, Mode=OneWay}">
                <muxc:ItemsRepeater.Layout>
                    <primitives:ColumnMajorUniformToLargestGridLayout
                        ColumnSpacing="8"
                        MaxColumns="2147483647"
                        RowSpacing="8" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:IndexPageModel">
                        <Button
                            x:Name="Root"
                            MinWidth="64"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource SystemControlTransparentBrush}"
                            Click="Button_Click"
                            Style="{ThemeResource TransparentButtonStyle}"
                            Tag="{x:Bind}">
                            <control:StackPanel HorizontalAlignment="Stretch" Spacing="2">
                                <Border
                                    Width="40"
                                    Height="40"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <control:ImageEx
                                        Model="{x:Bind Pic}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Stretch="Uniform" />
                                </Border>
                                <TextBlock
                                    x:Name="TitleText"
                                    HorizontalAlignment="Center"
                                    MaxLines="1"
                                    Text="{x:Bind Title, Mode=OneWay}" />
                            </control:StackPanel>
                        </Button>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MessageCardTemplate" x:DataType="models:IndexPageMessageCardModel">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <control:TextBlockEx
                    x:Name="Description"
                    Grid.Row="1"
                    Text="{x:Bind Description, Mode=OneWay}"
                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <muxc:ItemsRepeaterScrollHost
                x:Name="EntitiesHost"
                Grid.Row="1"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ScrollViewer
                    Padding="8"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollMode="Disabled">
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource ItemTemplateSelector}" ItemsSource="{x:Bind Entities, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Orientation="Horizontal" Spacing="8" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </muxc:ItemsRepeaterScrollHost>
        </Grid>
    </DataTemplate>

