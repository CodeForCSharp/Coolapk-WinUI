    <DataTemplate x:Key="IconMiniGridCardTemplate" x:DataType="models:IconMiniGridCardModel">
        <Grid>
            <muxc:ItemsRepeater
                Margin="8,0,8,8"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource IconMiniGridItemTemplate}"
                ItemsSource="{x:Bind Entities, Mode=OneWay}"
                Visibility="{x:Bind ShowEntities, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
