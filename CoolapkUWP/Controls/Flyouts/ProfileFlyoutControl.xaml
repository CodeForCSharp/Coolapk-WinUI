<UserControl
    x:Class="CoolapkUWP.Controls.ProfileFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:feedpages="using:CoolapkUWP.ViewModels.FeedPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:templates="using:CoolapkUWP.Controls.DataTemplates"
    d:DataContext="{d:DesignInstance Type=feedpages:ProfileFlyoutViewModel}"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:ProfileCardTemplates />
            </ResourceDictionary.MergedDictionaries>
            <templates:ProfileCardTemplateSelector
                x:Key="ProfileCardTemplateSelector"
                ImageTextScrollCard="{StaticResource ImageTextScrollCardTemplate}"
                Others="{StaticResource Empty}"
                TextLinkList="{StaticResource TextLinkListCardTemplate}"
                TitleCard="{StaticResource TitleCardTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <controls:StackPanel Padding="12" Spacing="12">
            <controls:StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <ReorderThemeTransition />
                </TransitionCollection>
            </controls:StackPanel.ChildrenTransitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <muxc:PersonPicture
                    Width="49"
                    Height="49"
                    DisplayName="{x:Bind Provider.ProfileDetail.UserName, Mode=OneWay}"
                    DoubleTapped="Grid_DoubleTapped"
                    IsDoubleTapEnabled="True"
                    ProfilePicture="{x:Bind Provider.ProfileDetail.UserAvatar.Pic, Mode=OneWay}" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Provider.ProfileDetail.UserName, Mode=OneWay, FallbackValue=登录}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind Provider.ProfileDetail.LevelNum, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Lv.{0}', FallbackValue=Lv.0}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Text="{x:Bind Provider.ProfileDetail.NextLevelNowExperience, Mode=OneWay}" />
                    </Grid>
                    <muxc:ProgressBar
                        x:Name="NextLevelPercentage"
                        Grid.Row="2"
                        MinWidth="160"
                        Margin="0,4"
                        Value="{x:Bind Provider.ProfileDetail.NextLevelPercentage, Mode=OneWay}" />
                </Grid>
                <Button
                    x:Name="QRCodeButton"
                    x:Uid="/ProfileFlyoutControl/QRCodeButton"
                    Grid.Column="4"
                    Margin="-8,4"

                    Content="&#xED14;"
                    Style="{StaticResource NavigationIconButtonNormalStyle}"
                    Visibility="{x:Bind Provider.IsLogin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <Button.Flyout>
                        <Flyout ShouldConstrainToRootBounds="False">
                            <Flyout.FlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <controls:ShowQRCodeControl QRCodeText="{x:Bind Provider.ProfileDetail.Url, Mode=OneWay}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="LoginButton"
                    x:Uid="/ProfileFlyoutControl/LoginButton"
                    Grid.Column="4"
                    Margin="-8,4"
                    Click="Button_Click"
                    Content="&#xE78B;"
                    Style="{StaticResource NavigationIconButtonNormalStyle}"
                    Tag="LoginButton"
                    Visibility="{x:Bind Provider.IsLogin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="L" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>
            <Grid x:Name="ButtonGrid"                 Visibility="{x:Bind Provider.IsLogin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"

                    CornerRadius="{x:Bind LeftButtonCornerRadius}"
                    Click="Button_Click"
                    Tag="FeedsButton">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{x:Bind Provider.ProfileDetail.FeedNum, Mode=OneWay, FallbackValue=0}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="动态" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"

                    CornerRadius="0"
                    BorderThickness="0,1"
                    Click="Button_Click"
                    Tag="FollowsButton">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{x:Bind Provider.ProfileDetail.FollowNum, Mode=OneWay, FallbackValue=0}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="关注" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"

                    CornerRadius="{x:Bind RightButtonCornerRadius}"
                    Click="Button_Click"
                    Tag="FansButton">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{x:Bind Provider.ProfileDetail.FansNum, Mode=OneWay, FallbackValue=0}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="粉丝" />
                    </StackPanel>
                </Button>
            </Grid>
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Click="Button_Click"
                Tag="CreateFeedButton"
                Visibility="{x:Bind Provider.IsLogin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:StackPanel
                    Margin="8,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Glyph="&#xE932;" />
                    <TextBlock
                        x:Uid="/ProfileFlyoutControl/CreateFeed"
                        Margin="0,0,0,2"
                        FontSize="16" />
                </controls:StackPanel>
            </Button>
            <Border MaxWidth="300"                 Visibility="{x:Bind Provider.Any, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <muxc:ItemsRepeater ItemTemplate="{StaticResource ProfileCardTemplateSelector}" ItemsSource="{x:Bind Provider, Mode=OneWay}">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout Orientation="Vertical" Spacing="12" />
                    </muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
            </Border>
        </controls:StackPanel>
    </ScrollViewer>
</UserControl>
