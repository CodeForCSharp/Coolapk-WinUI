<Page
    x:Class="CoolapkUWP.Pages.FeedPages.RankingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CoolapkUWP.Models"
    xmlns:feedpages="using:CoolapkUWP.ViewModels.FeedPages"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:templates="using:CoolapkUWP.Controls.DataTemplates"
    xmlns:ui="using:CommunityToolkit.WinUI"
    d:DataContext="{d:DesignInstance Type=feedpages:RankingViewModel}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:IndexCardTemplates />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="RankingTabTemplate" x:DataType="models:RankingTabModel">
                <Button
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    Click="RankingTab_Click"
                    Style="{ThemeResource TransparentButtonStyle}"
                    Tag="{x:Bind}">
                    <Border
                        Padding="18,6"
                        Background="{x:Bind PillBackground, Mode=OneWay}"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="13"
                            Foreground="{x:Bind PillForeground, Mode=OneWay}"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListView
            x:Name="TabListView"
            Grid.Row="0"
            Padding="12,0,12,8"
            ItemContainerStyle="{StaticResource TransparentCardItemStyle}"
            ItemTemplate="{StaticResource RankingTabTemplate}"
            ItemsSource="{x:Bind Provider.Tabs, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.HorizontalScrollMode="Auto"
            ScrollViewer.IsHorizontalRailEnabled="True"
            ScrollViewer.IsVerticalScrollChainingEnabled="False"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionChanged="TabListView_SelectionChanged"
            SelectionMode="Single"
            ShowsScrollingPlaceholders="False">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        <muxc:RefreshContainer
            x:Name="RefreshContainer"
            Grid.Row="1"
            RefreshRequested="RefreshContainer_RefreshRequested">
            <ListView
                x:Name="ProductListView"
                ui:ListViewExtensions.ItemContainerStretchDirection="Horizontal"
                ItemContainerStyle="{StaticResource DefaultCardItemStyle}"
                ItemTemplate="{StaticResource ProductItemTemplate}"
                ItemsSource="{x:Bind Provider.SelectedSource, Mode=OneWay}"
                Loaded="ProductListView_Loaded"
                ShowsScrollingPlaceholders="False"
                Style="{StaticResource DefaultCardListViewStyle}" />
        </muxc:RefreshContainer>
    </Grid>
</Page>