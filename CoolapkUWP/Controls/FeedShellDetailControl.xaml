<UserControl
    x:Class="CoolapkUWP.Controls.FeedShellDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:CoolapkUWP.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:feeds="using:CoolapkUWP.Models.Feeds"
    xmlns:local="using:CoolapkUWP.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:templates="using:CoolapkUWP.Controls.DataTemplates"
    d:DataContext="{d:DesignInstance Type=feeds:FeedDetailModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:PicTemplates />
                <templates:FeedsTemplates />
                <templates:RelationRowsTemplates />
            </ResourceDictionary.MergedDictionaries>
            <converters:HTMLToTextConverter x:Key="HTMLToTextConverter" />
            <MenuFlyout x:Key="MoreFlyout">
                <MenuFlyoutSubItem x:Uid="/Feed/Copy">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem
                        x:Uid="/Feed/CopyLink"
                        Click="CopyMenuItem_Click"
                        Tag="{x:Bind FeedDetail.ShareUrl, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="/Feed/CopyAll"
                        Click="CopyMenuItem_Click"
                        Tag="{x:Bind FeedDetail.Message, Converter={StaticResource HTMLToTextConverter}, Mode=OneWay}" />
                    <MenuFlyoutItem
                        Click="CopyMenuItem_Click"
                        Tag="{x:Bind FeedDetail.UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='@{0}', Mode=OneWay}"
                        Text="{x:Bind FeedDetail.UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='复制 @{0}', Mode=OneWay}" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem
                    x:Name="PinTileButton"
                    x:Uid="/Feed/PinTile"
                    Click="Button_Click"
                    Tag="{x:Bind FeedDetail, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE840;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Name="ReportButton"
                    x:Uid="/Feed/Report"
                    Click="Button_Click"
                    Tag="{x:Bind FeedDetail.ID, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://m.coolapk.com/mp/do?c=feed&amp;m=report&amp;type=feed&amp;id={0}', Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid
        Padding="{x:Bind Padding, Mode=TwoWay}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource SystemControlTransparentBrush}"
        ContextFlyout="{StaticResource MoreFlyout}">
        <Grid Padding="12,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="FeedArticleTitle"
                Grid.Row="0"
                Margin="0,0,0,4"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind FeedDetail.IsFeedArticle, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <local:ImageEx
                    Model="{x:Bind FeedDetail.MessageCover}"
                    Stretch="UniformToFill"
                    Tag="{x:Bind FeedDetail.MessageCover, Mode=OneWay}"
                    Tapped="OnTapped"
                    Visibility="{x:Bind FeedDetail.MessageCover.Uri, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <Border
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    CornerRadius="0,0,8,8">
                    <TextBlock
                        Margin="8,4"
                        HorizontalAlignment="Left"
                        FontSize="20"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind FeedDetail.MessageTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
            <Button
                Grid.Row="1"
                Height="40"
                Margin="0,0,0,4"
                Padding="4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="UrlButton_Click"
                Tag="{x:Bind FeedDetail.QuestionUrl, Mode=OneWay}"
                Visibility="{x:Bind FeedDetail.IsAnswerFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="查看全部" />
                        <Run Text="{x:Bind FeedDetail.QuestionAnswerNum, Mode=OneWay}" />
                        <Run Text="个答案" />
                    </TextBlock>
                    <FontIcon
                        Grid.Column="2"
                        Margin="8,0"
                        HorizontalAlignment="Right"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Glyph="&#xE72A;"
                        Visibility="{x:Bind FeedDetail.QuestionUrl, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Button>
            <Button
                Grid.Row="2"
                Height="40"
                Margin="0,0,0,4"
                Padding="4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="UrlButton_Click"
                Tag="{x:Bind FeedDetail.TopicUrl, Mode=OneWay}"
                Visibility="{x:Bind FeedDetail.ShowTopicTitle, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <local:ImageEx
                            Model="{x:Bind FeedDetail.TopicLogo}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{x:Bind FeedDetail.TopicTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind FeedDetail.TopicTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    <FontIcon
                        Grid.Column="2"
                        Margin="8,0"
                        HorizontalAlignment="Right"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Glyph="&#xE72A;"
                        Visibility="{x:Bind FeedDetail.TopicUrl, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Button>
            <Button
                Grid.Row="3"
                Height="40"
                Margin="0,0,0,4"
                Padding="4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="UrlButton_Click"
                Tag="{x:Bind FeedDetail.DyhUrl, Mode=OneWay}"
                Visibility="{x:Bind FeedDetail.ShowDyhName, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <local:ImageEx
                            Model="{x:Bind FeedDetail.DyhLogo}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="{x:Bind FeedDetail.DyhName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind FeedDetail.DyhName, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind FeedDetail.DyhSubTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind FeedDetail.DyhSubTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                    <FontIcon
                        Grid.Column="2"
                        Margin="8,0"
                        HorizontalAlignment="Right"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Glyph="&#xE72A;"
                        Visibility="{x:Bind FeedDetail.DyhUrl, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Button>
            <Grid x:Name="UserBar" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="0,4"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource SystemControlTransparentBrush}"
                    Click="Button_Click"
                    Style="{StaticResource TransparentButtonStyle}"
                    Tag="{x:Bind FeedDetail.UserInfo.Url, Mode=OneWay}">
                    <muxc:PersonPicture
                        Width="36"
                        Height="36"
                        DisplayName="{x:Bind FeedDetail.UserInfo.UserName, Mode=OneWay}"
                        ProfilePicture="{x:Bind FeedDetail.UserInfo.UserAvatar.Pic, Mode=OneWay}" />
                </Button>
                <Grid
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind FeedDetail.UserInfo.UserName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind FeedDetail.Dateline, Mode=OneWay}" />
                        <Run Text="{x:Bind FeedDetail.Info, Mode=OneWay}" />
                        <Hyperlink
                            Click="DeviceHyperlink_Click"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            UnderlineStyle="None">
                            <Run Text="{x:Bind FeedDetail.DeviceTitle, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>
                <Button
                    x:Name="FollowButton"
                    Grid.Column="2"
                    Height="32"
                    HorizontalAlignment="Right"
                    Click="Button_Click"
                    Style="{StaticResource TransparentButtonStyle}"
                    Tag="{x:Bind FeedDetail, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind FollowStatus.Text, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="15"
                            Glyph="{x:Bind FeedDetail.UserAction.FollowGlyph, Mode=OneWay}" />
                        <TextBlock
                            x:Name="FollowStatus"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Bind FeedDetail.UserAction.FollowStatus, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
            <local:StackPanel
                Grid.Row="5"
                Margin="4"
                Spacing="4">
                <Grid Margin="0,-4" Visibility="{x:Bind FeedDetail.IsRatingFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            x:Uid="/Feed/Rating"
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <muxc:RatingControl
                        x:Name="RatingStarControl"
                        Grid.Column="1"
                        Margin="8,7,8,0"
                        IsReadOnly="True"
                        Value="{x:Bind FeedDetail.RatingStar, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind FeedDetail.RatingStar, Converter={StaticResource NumMultConverter}, ConverterParameter='2', Mode=OneWay}" />
                        <Run Text="分" />
                    </TextBlock>
                </Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Margin="0,4"
                        Visibility="{x:Bind FeedDetail.IsFeedArticle, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, ConverterParameter='true', FallbackValue='Collapsed'}">
                        <local:TextBlockEx
                            x:Name="MessageTitle"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            FontWeight="Black"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind FeedDetail.MessageTitle, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind FeedDetail.MessageTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    </Border>
                    <local:TextBlockEx
                        x:Name="Message"
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind FeedDetail.Message, Mode=OneWay}"
                        Visibility="{x:Bind FeedDetail.MessageRawOutput, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, ConverterParameter='true'}" />
                    <local:TextBlockEx
                        x:Name="ArticleMessage"
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind FeedDetail.MessageRawOutput, Mode=OneWay}"
                        Visibility="{x:Bind FeedDetail.MessageRawOutput, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}" />
                </Grid>
            </local:StackPanel>
            <Grid
                Grid.Row="6"
                MinHeight="0"
                Margin="4"
                Visibility="{x:Bind FeedDetail.MessageRawOutput, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, ConverterParameter='true', FallbackValue='Collapsed'}">
                <GridView
                    MinHeight="0"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    ItemTemplate="{StaticResource PicDefaultTemplate}"
                    ItemsSource="{x:Bind FeedDetail.PicArr, Mode=OneWay}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionChanged="GridView_SelectionChanged"
                    Visibility="{x:Bind FeedDetail.PicArr, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
            <StackPanel
                Grid.Row="7"
                Margin="0,4"
                Padding="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind FeedDetail.VoteRows, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <muxc:ItemsRepeater
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource VoteItemTemplate}"
                    ItemsSource="{x:Bind FeedDetail.VoteRows, Mode=OneWay}">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout />
                    </muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="{x:Bind FeedDetail.IsCopyEnabled, Mode=OneWay}">
                        <Run FontWeight="Bold" Text="{x:Bind FeedDetail.TotalVoteNum, Mode=OneWay}" />
                        <Run Text="人投票" />
                        <Run Text="•" />
                        <Run FontWeight="Bold" Text="{x:Bind FeedDetail.TotalCommentNum, Mode=OneWay}" />
                        <Run Text="个观点" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="{x:Bind FeedDetail.IsCopyEnabled, Mode=OneWay}">
                        <Run FontWeight="Bold" Text="{x:Bind FeedDetail.VoteStartTime, Mode=OneWay}" />
                        <Run Text="-" />
                        <Run FontWeight="Bold" Text="{x:Bind FeedDetail.VoteEndTime, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </StackPanel>
            <Border
                Grid.Row="8"
                Margin="0,4"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind FeedDetail.ShowSourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <Grid
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <TextBlock
                        x:Uid="/Feed/SourceFeedNotFound"
                        Margin="12,8"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind FeedDetail.EmptySourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <Border Visibility="{x:Bind FeedDetail.EmptySourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, ConverterParameter='true'}">
                        <local:WebViewContentControl
                            ContentCornerRadius="{ThemeResource OverlayCornerRadius}"
                            ContentTemplate="{StaticResource SourceFeedDefaultTemplate}"
                            DataContext="{x:Bind FeedDetail.SourceFeed, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>
            <Grid
                Grid.Row="9"
                Margin="0,4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind FeedDetail.ExtraTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <local:ImageEx
                    Model="{x:Bind FeedDetail.ExtraPic}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="UniformToFill" />
                <Grid
                    Padding="8"
                    Tag="{x:Bind FeedDetail.ExtraUrl, Mode=OneWay}"
                    Tapped="OnTapped"
                    Visibility="{x:Bind FeedDetail.ShowLinkSourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, ConverterParameter='true'}">
                        <Grid.Background>
                        <AcrylicBrush
                           
                            FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                            TintColor="{ThemeResource SystemChromeMediumHighColor}"
                            TintOpacity="1" />
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="56"
                        Height="56"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind FeedDetail.ExtraPic.Uri, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                        <local:ImageEx
                            Model="{x:Bind FeedDetail.ExtraPic}"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Stretch="UniformToFill" />
                    </Border>
                    <Border
                        Width="56"
                        Height="56"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind FeedDetail.ExtraPic.Uri, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, ConverterParameter='true'}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Glyph="&#xE71B;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Left"
                            MaxLines="2"
                            Text="{x:Bind FeedDetail.ExtraTitle, Mode=OneWay}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind FeedDetail.ExtraTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind FeedDetail.ExtraSubtitle, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind FeedDetail.ExtraSubtitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <Grid CornerRadius="{ThemeResource OverlayCornerRadius}" Visibility="{x:Bind FeedDetail.ShowLinkSourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Grid.Background>
                        <AcrylicBrush
                           
                            FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                            TintColor="{ThemeResource SystemChromeMediumHighColor}"
                            TintOpacity="1" />
                    </Grid.Background>
                    <local:WebViewContentControl
                        ContentCornerRadius="{ThemeResource OverlayCornerRadius}"
                        ContentTemplate="{StaticResource SourceFeedDefaultTemplate}"
                        DataContext="{x:Bind FeedDetail.LinkSourceFeed, Mode=OneWay}" />
                    <Border Visibility="{x:Bind FeedDetail.LinkSourceFeed.Succeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, ConverterParameter='true'}">
                            <Border.Child>
                            <muxc:ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind FeedDetail.LinkSourceFeed.Succeed, Converter={StaticResource BoolNegationConverter}, Mode=OneWay, ConverterParameter='true'}" />
                        </Border.Child>
                    </Border>
                </Grid>
            </Grid>
            <Grid
                Grid.Row="10"
                Margin="0,4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind FeedDetail.MediaUrl, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <local:ImageEx
                    Model="{x:Bind FeedDetail.MediaPic}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="UniformToFill" />
                <Grid
                    Padding="8"
                    Tag="{x:Bind FeedDetail.MediaUrl, Mode=OneWay}"
                    Tapped="OnTapped"
                    Visibility="{x:Bind FeedDetail.ShowLinkSourceFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, ConverterParameter='true'}">
                        <Grid.Background>
                        <AcrylicBrush
                           
                            FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                            TintColor="{ThemeResource SystemChromeMediumHighColor}"
                            TintOpacity="1" />
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="56"
                        Height="56"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind FeedDetail.MediaPic.Uri, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                        <local:ImageEx
                            Model="{x:Bind FeedDetail.MediaPic}"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Stretch="UniformToFill" />
                    </Border>
                    <Border
                        Width="56"
                        Height="56"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind FeedDetail.MediaPic.Uri, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, ConverterParameter='true'}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Glyph="&#xE786;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Uid="/Feed/MediaShare"
                            HorizontalAlignment="Left"
                            MaxLines="2"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind FeedDetail.MediaSubtitle, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind FeedDetail.MediaSubtitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <muxc:ItemsRepeaterScrollHost
                Grid.Row="11"
                Margin="2,0"
                Visibility="{x:Bind FeedDetail.RelationRows, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                <ScrollViewer
                    Padding="0,4"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Auto"
                    VerticalScrollMode="Disabled">
                    <muxc:ItemsRepeater
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource RelationRowsItemTemplate}"
                        ItemsSource="{x:Bind FeedDetail.RelationRows, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Orientation="Horizontal" Spacing="6" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </muxc:ItemsRepeaterScrollHost>
            <StackPanel
                Grid.Row="12"
                Margin="4"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <TextBlock
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Visibility="{x:Bind FeedDetail.IsQuestionFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                    <Run FontWeight="Bold" Text="{x:Bind FeedDetail.QuestionAnswerNum, Mode=OneWay}" />
                    <Run Text="人回答" />
                    <Run Text="•" />
                    <Run FontWeight="Bold" Text="{x:Bind FeedDetail.QuestionFollowNum, Mode=OneWay}" />
                    <Run Text="人关注" />
                </TextBlock>
                <Border
                    Margin="2,0"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind FeedDetail.IsQuestionFeed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="•"
                        Visibility="{x:Bind FeedDetail.IPLocation, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Visibility="{x:Bind FeedDetail.IPLocation, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                    <Run x:Uid="/Feed/PublishFrom" />
                    <Run FontWeight="Bold" Text="{x:Bind FeedDetail.IPLocation, Mode=OneWay}" />
                </TextBlock>
                <Border
                    Margin="2,0"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind FeedDetail.IPLocation, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="•"
                        Visibility="{x:Bind FeedDetail.ReadNum, Converter={StaticResource DoubleToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Visibility="{x:Bind FeedDetail.ReadNum, Converter={StaticResource DoubleToVisibilityConverter}, Mode=OneWay, FallbackValue='Collapsed'}">
                    <Run FontWeight="Bold" Text="{x:Bind FeedDetail.ReadNum, Mode=OneWay}" />
                    <Run x:Uid="/Feed/ReadNum" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
