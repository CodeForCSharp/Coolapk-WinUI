            </muxc:ItemsRepeater>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IconMiniScrollCardItemTemplate" x:DataType="models:IndexPageModel">
        <Button
            Padding="0"
            HorizontalContentAlignment="Stretch"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Click="Button_Click"
            Style="{ThemeResource TransparentButtonStyle}"
            Tag="{x:Bind}">
            <Grid ColumnSpacing="8" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    CornerRadius="4">
                    <control:ImageEx
