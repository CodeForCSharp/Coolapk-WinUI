    </DataTemplate>

    <DataTemplate x:Key="IconLongTitleItemTemplate" x:DataType="models:IndexPageModel">
        <Button
            Width="96"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Click="Button_Click"
            Style="{ThemeResource TransparentButtonStyle}"
            Tag="{x:Bind}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <control:ImageEx
                        Model="{x:Bind Pic}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    MinHeight="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    MaxLines="2"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind SubTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind SubTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <!--  二级卡片  -->

    <DataTemplate x:Key="SquareLinkCardTemplate" x:DataType="models:IndexPageModel">
        <Border
            Width="86"
            Height="86"
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <Grid>
                <control:ImageEx
                    Model="{x:Bind Pic}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="UniformToFill" />
                <Grid
                    Padding="4"
                    VerticalAlignment="Bottom"
                CornerRadius="0,0,8,8"
                Tag="{x:Bind}"
                Tapped="Grid_Tapped">
                    <Grid.Background>
                    <AcrylicBrush
                       
                        FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintOpacity="1" />
                </Grid.Background>
                <TextBlock
                    Margin="2"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    MaxLines="1"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="IconLinkTemplate" x:DataType="models:IndexPageModel">
        <Border
            Width="86"
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <Grid>
                <control:ImageEx
                    Model="{x:Bind Pic}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="UniformToFill" />
                <StackPanel Padding="4" CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel.Background>
                    <AcrylicBrush
                       
                        FallbackColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintColor="{ThemeResource SystemChromeMediumHighColor}"
                        TintOpacity="1" />
                </StackPanel.Background>
                <Border
                    Width="36"
                    Height="36"
                    Margin="4"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Tag="{x:Bind}"
                    Tapped="Grid_Tapped">
                    <control:ImageEx
                        Model="{x:Bind Pic}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    MaxLines="1"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SubTitle"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind SubTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind SubTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LinkTemplate" x:DataType="models:IndexPageModel">
        <Grid
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <Border CornerRadius="{ThemeResource OverlayCornerRadius}">
                <control:ImageEx
                    Model="{x:Bind Pic}"
                    MaxWidth="160"
                    MaxHeight="65"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="UniformToFill" />
            </Border>
            <Border
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                <TextBlock
                    Margin="8,0"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageTextTemplate" x:DataType="models:IndexPageModel">
        <Grid
            Width="260"
            Height="118"
            BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            KeyDown="Grid_KeyDown"
            Tag="{x:Bind}"
            Tapped="Grid_Tapped">
            <control:ImageEx
                Model="{x:Bind Pic}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Stretch="Fill" />
            <Border
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="{x:Bind templates:IndexCardTemplates.BottomOverlayCornerRadius}">
                <TextBlock
                    Margin="8"
                    FontSize="16"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="WordEllipsis" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MiniUserTemplate" x:DataType="users:UserModel">
        <Button
            Width="86"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Click="Button_Click"
            Style="{ThemeResource TransparentButtonStyle}"
            Tag="{x:Bind}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Width="36"
                    Height="36"
                    Margin="8"
                    HorizontalAlignment="Center"
                    CornerRadius="18">
                    <control:ImageEx
                        Model="{x:Bind Pic}"
                        CornerRadius="18"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="MiniIconLinkTemplate" x:DataType="models:IHasDescription">
        <Button
            Width="124"
            MinHeight="0"
            Padding="0"
            HorizontalContentAlignment="Left"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Click="Button_Click"
            Style="{ThemeResource TransparentButtonStyle}"
            Tag="{x:Bind}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    Margin="8"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <control:ImageEx
                        Model="{x:Bind Pic}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
