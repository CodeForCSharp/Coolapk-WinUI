<ResourceDictionary
    x:Class="CoolapkUWP.Controls.DataTemplates.OtherDataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CoolapkUWP.Models"
    xmlns:users="using:CoolapkUWP.Models.Users"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <DataTemplate x:Key="Empty" />

    <DataTemplate x:Key="UserTemplate" x:DataType="users:UserModel">
        <Grid
            Padding="8"
            KeyDown="OnKeyDown"
            Tag="{x:Bind Url, Mode=OneWay}"
            Tapped="OnTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <muxc:PersonPicture
                Grid.RowSpan="2"
                Width="36"
                Height="36"
                Margin="0,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                DisplayName="{x:Bind UserName, Mode=OneWay}"
                ProfilePicture="{x:Bind UserAvatar.Pic, Mode=OneWay}" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{x:Bind UserName, Mode=OneWay}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind FollowNum, Mode=OneWay}" />
                <Run Text="{x:Bind FansNum, Mode=OneWay}" />
                <Run Text="{x:Bind LoginTime, Mode=OneWay}" />
            </TextBlock>
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Text="{x:Bind Bio, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Bio, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ListDefaultTemplate" x:DataType="models:IHasDescription">
        <Grid
            Padding="0,8"
            KeyDown="OnKeyDown"
            Tag="{x:Bind Url, Mode=OneWay}"
            Tapped="OnTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <ctrl:ImageEx
                    Model="{x:Bind Pic}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="UniformToFill" />
            </Border>
            <Grid
                Grid.Column="1"
                Margin="0,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind Title, Mode=OneWay}"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <ctrl:TextBlockEx
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind Description, Mode=OneWay}"
                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SubtitleListDefaultTemplate" x:DataType="models:IHasSubtitle">
        <Grid
            Padding="0,8"
            KeyDown="OnKeyDown"
            Tag="{x:Bind Url, Mode=OneWay}"
            Tapped="OnTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ctrl:ImageEx
                    Model="{x:Bind Pic}"
                    CornerRadius="20"
                    Stretch="UniformToFill" />
            </Border>
            <Grid
                Grid.Column="1"
                Margin="0,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind Title, Mode=OneWay}"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind SubTitle, Mode=OneWay}"
                    Visibility="{x:Bind SubTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <ctrl:TextBlockEx
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind Description, Mode=OneWay}"
                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
