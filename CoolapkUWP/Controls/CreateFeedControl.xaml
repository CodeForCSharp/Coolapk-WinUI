<local:Picker
    x:Class="CoolapkUWP.Controls.CreateFeedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:CoolapkUWP.Helpers"
    xmlns:local="using:CoolapkUWP.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CoolapkUWP.Models"
    xmlns:users="using:CoolapkUWP.Models.Users"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Padding="25"
    Loaded="Picker_Loaded"
    Unloaded="Picker_Unloaded"
    mc:Ignorable="d">
    <local:Picker.Resources>
        <ResourceDictionary>
            <local:EmojiNameConverter x:Key="EmojiNameConverter" />
            <local:StringToEmojiConverter x:Key="StringToEmojiConverter" />
            <DataTemplate x:Key="EmojiImageTemplate" x:DataType="x:String">
                <Image
                    Width="36"
                    Height="36"
                    Source="{x:Bind Converter={StaticResource StringToEmojiConverter}, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Converter={StaticResource EmojiNameConverter}, Mode=OneWay}" />
            </DataTemplate>
        </ResourceDictionary>
    </local:Picker.Resources>
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource SystemControlTransparentBrush}"
        DragOver="Grid_DragOver"
        Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:PageHeader
            x:Name="HeaderControl"
            Title="{x:Bind Provider.Title, Mode=OneWay}"
            Margin="18,0,0,0"
            FontSize="{StaticResource ContentControlFontSize}"
            FontWeight="Normal">
            <Button
                Margin="-8,0,0,0"
                VerticalAlignment="Center"
                Click="Button_Click"
                Content="&#xE10A;"
                Style="{StaticResource NavigationIconButtonNormalStyle}"
                Tag="CloseButton">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control,Shift" />
                </Button.KeyboardAccelerators>
            </Button>
        </local:PageHeader>
        <RichEditBox
            x:Name="InputBox"
            x:Uid="/CreateFeedControl/EditBox"
            Grid.Row="1"
            Margin="6,0"
            AcceptsReturn="True"
            Background="{ThemeResource SystemControlTransparentBrush}"
            BorderBrush="{ThemeResource SystemControlTransparentBrush}"
            Loaded="InputBox_Loaded"
            TextWrapping="Wrap" />
        <GridView
            Grid.Row="2"
            Padding="10,8,10,0"
            HorizontalContentAlignment="Left"
            ItemsSource="{x:Bind Provider.Pictures, Mode=OneWay}"
            SelectionChanged="GridView_SelectionChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border
                        Width="102"
                        Height="102"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Border.BackgroundTransition>
                            <BrushTransition />
                        </Border.BackgroundTransition>
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Name="DeletePic"
                                    x:Uid="/CreateFeedControl/DeletePicItem"
                                    Click="MenuFlyoutItem_Click"
                                    Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <CommandBar Grid.Row="3" OverflowButtonVisibility="Collapsed">
            <AppBarButton
                x:Uid="/CreateFeedControl/LinkButton"
                AllowFocusOnInteraction="True"
                Tag="Link">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="L" Modifiers="Control,Shift" />
                </AppBarButton.KeyboardAccelerators>
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71B;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout x:Name="LinkFlyout" ShouldConstrainToRootBounds="False">
                        <Flyout.FlyoutPresenterStyle>
                            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MaxHeight" Value="320" />
                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Pivot>
                            <PivotItem x:Uid="/CreateFeedControl/UserPivotItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <AutoSuggestBox
                                        x:Uid="/CreateFeedControl/UserSearchBox"
                                        Margin="8,4"
                                        IsTabStop="True"
                                        QuerySubmitted="UserAutoSuggestBox_QuerySubmitted">
                                        <AutoSuggestBox.QueryIcon>
                                            <muxc:AnimatedIcon>
                                                <muxc:AnimatedIcon.Source>
                                                    <animatedvisuals:AnimatedFindVisualSource />
                                                </muxc:AnimatedIcon.Source>
                                                <muxc:AnimatedIcon.FallbackIconSource>
                                                    <muxc:FontIconSource
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Glyph="&#xE721;" />
                                                </muxc:AnimatedIcon.FallbackIconSource>
                                            </muxc:AnimatedIcon>
                                        </AutoSuggestBox.QueryIcon>
                                    </AutoSuggestBox>
                                    <muxc:RefreshContainer Grid.Row="1">
                                        <ListView
                                            Padding="4,0"
                                            ItemsSource="{x:Bind Provider.CreateUserItemSource, Mode=OneWay}"
                                            SelectionChanged="ListView_SelectionChanged"
                                            Tag="UserList">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="users:UserModel">
                                                    <Grid Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <muxc:PersonPicture
                                                            Width="24"
                                                            Height="24"
                                                            DisplayName="{x:Bind UserName, Mode=OneWay}"
                                                            ProfilePicture="{x:Bind UserAvatar.Pic, Mode=OneWay}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="10,0,0,2"
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind UserName, Mode=OneWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </muxc:RefreshContainer>
                                    <muxc:ProgressBar
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource SystemControlTransparentBrush}"
                                        IsIndeterminate="{x:Bind Provider.CreateUserItemSource.IsLoading, Mode=OneWay}" />
                                </Grid>
                            </PivotItem>
                            <PivotItem x:Uid="/CreateFeedControl/TopicPivotItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <AutoSuggestBox
                                        x:Uid="/CreateFeedControl/TopicSearchBox"
                                        Margin="8,4"
                                        IsTabStop="True"
                                        QuerySubmitted="TopicAutoSuggestBox_QuerySubmitted">
                                        <AutoSuggestBox.QueryIcon>
                                            <muxc:AnimatedIcon>
                                                <muxc:AnimatedIcon.Source>
                                                    <animatedvisuals:AnimatedFindVisualSource />
                                                </muxc:AnimatedIcon.Source>
                                                <muxc:AnimatedIcon.FallbackIconSource>
                                                    <muxc:FontIconSource
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Glyph="&#xE721;" />
                                                </muxc:AnimatedIcon.FallbackIconSource>
                                            </muxc:AnimatedIcon>
                                        </AutoSuggestBox.QueryIcon>
                                    </AutoSuggestBox>
                                    <muxc:RefreshContainer Grid.Row="1">
                                        <ListView
                                            Padding="4,0"
                                            ItemsSource="{x:Bind Provider.CreateTopicItemSource, Mode=OneWay}"
                                            SelectionChanged="ListView_SelectionChanged"
                                            Tag="TopicList">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:IndexPageModel">
                                                    <Grid Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="24"
                                                            Height="24"
                                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                                            <local:ImageEx
                                                                Model="{x:Bind Pic}"
                                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="10,0,0,2"
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind Title, Mode=OneWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </muxc:RefreshContainer>
                                    <muxc:ProgressBar
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource SystemControlTransparentBrush}"
                                        IsIndeterminate="{x:Bind Provider.CreateTopicItemSource.IsLoading, Mode=OneWay}" />
                                </Grid>
                            </PivotItem>
                        </Pivot>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                x:Uid="/CreateFeedControl/EmojiButton"
                AllowFocusOnInteraction="True"
                Tag="Emoji">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="E" Modifiers="Control,Shift" />
                </AppBarButton.KeyboardAccelerators>
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE76E;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout x:Name="EmojiFlyout" ShouldConstrainToRootBounds="False">
                        <Flyout.FlyoutPresenterStyle>
                            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MaxHeight" Value="320" />
                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <AutoSuggestBox
                                x:Uid="/CreateFeedControl/EmojiSearchBox"
                                Margin="8,8,8,-8"
                                IsTabStop="True"
                                SuggestionChosen="EmojiAutoSuggestBox_SuggestionChosen"
                                TextChanged="EmojiAutoSuggestBox_TextChanged">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="24"
                                                Height="24"
                                                Source="{x:Bind Converter={StaticResource StringToEmojiConverter}, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind Converter={StaticResource EmojiNameConverter}, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,2"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Converter={StaticResource EmojiNameConverter}, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                            <Pivot Grid.Row="1">
                                <PivotItem Header="常规">
                                    <GridView
                                        Padding="8,0"
                                        IsItemClickEnabled="True"
                                        ItemClick="EmojiGridView_ItemClick"
                                        ItemTemplate="{StaticResource EmojiImageTemplate}"
                                        ItemsSource="{x:Bind helpers:EmojiHelper.Normal}"
                                        SelectionChanged="GridView_SelectionChanged" />
                                </PivotItem>
                                <PivotItem Header="酷币">
                                    <GridView
                                        Padding="8,0"
                                        IsItemClickEnabled="True"
                                        ItemClick="EmojiGridView_ItemClick"
                                        ItemTemplate="{StaticResource EmojiImageTemplate}"
                                        ItemsSource="{x:Bind helpers:EmojiHelper.CoolCoins}"
                                        SelectionChanged="GridView_SelectionChanged" />
                                </PivotItem>
                                <PivotItem Header="滑稽">
                                    <GridView
                                        Padding="8,0"
                                        IsItemClickEnabled="True"
                                        ItemClick="EmojiGridView_ItemClick"
                                        ItemTemplate="{StaticResource EmojiImageTemplate}"
                                        ItemsSource="{x:Bind helpers:EmojiHelper.Funny}"
                                        SelectionChanged="GridView_SelectionChanged" />
                                </PivotItem>
                                <PivotItem Header="Doge">
                                    <GridView
                                        Padding="8,0"
                                        IsItemClickEnabled="True"
                                        ItemClick="EmojiGridView_ItemClick"
                                        ItemTemplate="{StaticResource EmojiImageTemplate}"
                                        ItemsSource="{x:Bind helpers:EmojiHelper.Doge}"
                                        SelectionChanged="GridView_SelectionChanged" />
                                </PivotItem>
                                <PivotItem Header="传统">
                                    <GridView
                                        Padding="8,0"
                                        IsItemClickEnabled="True"
                                        ItemClick="EmojiGridView_ItemClick"
                                        ItemTemplate="{StaticResource EmojiImageTemplate}"
                                        ItemsSource="{x:Bind helpers:EmojiHelper.Tradition}"
                                        SelectionChanged="GridView_SelectionChanged" />
                                </PivotItem>
                                <PivotItem Header="经典">
                                    <GridView
                                        Padding="8,0"
                                        IsItemClickEnabled="True"
                                        ItemClick="EmojiGridView_ItemClick"
                                        ItemTemplate="{StaticResource EmojiImageTemplate}"
                                        ItemsSource="{x:Bind helpers:EmojiHelper.Classic}"
                                        SelectionChanged="GridView_SelectionChanged" />
                                </PivotItem>
                            </Pivot>
                        </Grid>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                x:Uid="/CreateFeedControl/AddPicButton"
                Click="AppBarButton_Click"
                Tag="AddPic">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="P" Modifiers="Control,Shift" />
                </AppBarButton.KeyboardAccelerators>
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE710;" />
                </AppBarButton.Icon>
                <AppBarButton.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Name="PastePic"
                            x:Uid="/CreateFeedControl/PastePicItem"
                            Click="MenuFlyoutItem_Click"
                            Tag="PastePic">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="V"
                                    Modifiers="Control"
                                    ScopeOwner="{x:Bind RootGrid}" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE77F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.ContextFlyout>
            </AppBarButton>
            <AppBarButton
                x:Name="SendButton"
                x:Uid="/CreateFeedControl/SendButton"
                Click="AppBarButton_Click"
                Tag="Send"
                ToolTipService.ToolTip="{x:Bind SendButton.Label}">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE724;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Grid>
</local:Picker>
