<Page
    x:Class="CoolapkUWP.Pages.FeedPages.FeedShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CoolapkUWP.Controls"
    xmlns:converters="using:CoolapkUWP.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:feedpages="using:CoolapkUWP.ViewModels.FeedPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    d:DataContext="{d:DesignInstance Type=feedpages:FeedShellViewModel}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:HTMLToTextConverter x:Key="HTMLToTextConverter" />
        <Style x:Key="ReplyFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border
                                x:Name="Pill"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Flyout x:Key="QRCodeFlyout" ShouldConstrainToRootBounds="False">
            <Flyout.FlyoutPresenterStyle>
                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <controls:ShowQRCodeControl QRCodeText="{x:Bind Provider.FeedDetail.ShareUrl, Mode=OneWay}" />
        </Flyout>
        <MenuFlyout x:Key="MoreFlyout">
            <MenuFlyoutSubItem x:Uid="/Feed/Copy">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                </MenuFlyoutSubItem.Icon>
                <MenuFlyoutItem
                    x:Uid="/Feed/CopyLink"
                    Click="CopyMenuItem_Click"
                    Tag="{x:Bind Provider.FeedDetail.ShareUrl, Mode=OneWay}" />
                <MenuFlyoutItem
                    x:Uid="/Feed/CopyAll"
                    Click="CopyMenuItem_Click"
                    Tag="{x:Bind Provider.FeedDetail.Message, Converter={StaticResource HTMLToTextConverter}, Mode=OneWay}" />
                <MenuFlyoutItem
                    Click="CopyMenuItem_Click"
                    Tag="{x:Bind Provider.FeedDetail.UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='@{0}', Mode=OneWay}"
                    Text="{x:Bind Provider.FeedDetail.UserInfo.UserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='复制 @{0}', Mode=OneWay}" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem
                x:Name="PinTileButton"
                x:Uid="/Feed/PinTile"
                Click="FeedButton_Click"
                Tag="{x:Bind Provider.FeedDetail, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE840;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="ReportButton"
                x:Uid="/Feed/Report"
                Click="FeedButton_Click"
                Tag="{x:Bind Provider.FeedDetail.ID, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://m.coolapk.com/mp/do?c=feed&amp;m=report&amp;type=feed&amp;id={0}', Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>
    <Grid>
        <muxc:TwoPaneView
            x:Name="TwoPaneView"
            Loaded="TwoPaneView_Loaded"
            MinWideModeWidth="804"
            ModeChanged="TwoPaneView_ModeChanged"
            Pane1Length="420"
            PanePriority="Pane2"
            TallModeConfiguration="SinglePane">
            <muxc:TwoPaneView.Pane1>
                <Grid x:Name="LeftGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:PageHeader
                        x:Name="HeaderControl"
                        Title="{x:Bind Provider.Title, Mode=OneWay}"
                        Grid.Row="0"
                        Margin="18,0,0,0"
                        FontSize="{StaticResource ContentControlFontSize}"
                        FontWeight="Normal">
                        <Button
                            x:Name="RefreshButton"
                            x:Uid="/FeedShellPage/RefreshButton"
                            VerticalAlignment="Center"
                            Content="&#xE72C;"
                            Style="{StaticResource NavigationIconButtonNormalStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </controls:PageHeader>
                    <ScrollViewer
                        x:Name="DetailScrollViewer"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="Pane1Grid">
                            <controls:FeedShellDetailControl x:Name="DetailControl" DataContext="{x:Bind Provider.FeedDetail, Mode=OneWay}" />
                        </Grid>
                    </ScrollViewer>
                    <Grid
                        x:Name="BtnsPanel"
                        Grid.Row="2"
                        MinHeight="48"
                        Padding="12,8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom">
                        <StackPanel HorizontalAlignment="Left" />
                        <controls:StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                x:Name="ReplyButton"
                                Height="32"
                                Click="FeedButton_Click"
                                Style="{StaticResource TransparentButtonStyle}"
                                Tag="{x:Bind Provider.FeedDetail, Mode=OneWay}"
                                ToolTipService.ToolTip="回复">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE90A;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Provider.FeedDetail.ReplyNum, Mode=OneWay, FallbackValue=0}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="LikeButton"
                                Height="32"
                                Click="FeedButton_Click"
                                Style="{StaticResource TransparentButtonStyle}"
                                Tag="{x:Bind Provider.FeedDetail, Mode=OneWay}"
                                ToolTipService.ToolTip="点赞">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE8E1;"
                                        Visibility="{x:Bind Provider.FeedDetail.Liked, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}" />
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Glyph="&#xE8E1;"
                                        Visibility="{x:Bind Provider.FeedDetail.Liked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Provider.FeedDetail.LikeNum, Mode=OneWay, FallbackValue=0}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="StarButton"
                                Height="32"
                                Click="FeedButton_Click"
                                Style="{StaticResource TransparentButtonStyle}"
                                Tag="{x:Bind Provider.FeedDetail, Mode=OneWay}"
                                ToolTipService.ToolTip="收藏">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE734;"
                                        Visibility="{x:Bind Provider.FeedDetail.Stared, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}" />
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Glyph="&#xE734;"
                                        Visibility="{x:Bind Provider.FeedDetail.Stared, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Provider.FeedDetail.StarNum, Mode=OneWay, FallbackValue=0}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ShareButton"
                                Height="32"
                                Click="FeedButton_Click"
                                Flyout="{StaticResource QRCodeFlyout}"
                                Style="{StaticResource TransparentButtonStyle}"
                                Tag="{x:Bind Provider.FeedDetail.ShareUrl, Mode=OneWay}"
                                ToolTipService.ToolTip="分享">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Provider.FeedDetail.ShareNum, Mode=OneWay, FallbackValue=0}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="MoreButton"
                                x:Uid="/Feed/MoreButton"
                                MinWidth="36"
                                Height="32"
                                Padding="8,0"
                                Flyout="{StaticResource MoreFlyout}"
                                Style="{StaticResource TransparentButtonStyle}">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE10C;" />
                            </Button>
                        </controls:StackPanel>
                    </Grid>
                </Grid>
            </muxc:TwoPaneView.Pane1>
            <muxc:TwoPaneView.Pane2>
                <Grid x:Name="RightGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="ReplyFilterBar"
                        Grid.Row="0"
                        Height="48"
                        Padding="16,0,8,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{x:Bind Provider.FeedDetail.ReplyNum, Converter={StaticResource StringFormatConverter}, ConverterParameter='共 {0} 回复', Mode=OneWay}" />
                        <Border
                            Grid.Column="1"
                            Padding="3"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="16">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton
                                    Click="ReplyFilter_Click"
                                    Content="默认"
                                    CornerRadius="14"
                                    GroupName="ReplyFilter"
                                    IsChecked="True"
                                    Style="{StaticResource ReplyFilterRadioStyle}"
                                    Tag="default" />
                                <RadioButton
                                    Click="ReplyFilter_Click"
                                    Content="最新"
                                    CornerRadius="14"
                                    GroupName="ReplyFilter"
                                    Style="{StaticResource ReplyFilterRadioStyle}"
                                    Tag="latest" />
                                <RadioButton
                                    Click="ReplyFilter_Click"
                                    Content="热门"
                                    CornerRadius="14"
                                    GroupName="ReplyFilter"
                                    Style="{StaticResource ReplyFilterRadioStyle}"
                                    Tag="hot" />
                                <RadioButton
                                    Click="ReplyFilter_Click"
                                    Content="楼主"
                                    CornerRadius="14"
                                    GroupName="ReplyFilter"
                                    Style="{StaticResource ReplyFilterRadioStyle}"
                                    Tag="author" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <controls:FeedShellListControl
                        x:Name="ListControl"
                        Grid.Row="1"
                        Padding="7,3,7,4"
                        ItemSource="{x:Bind Provider.ItemSource, Mode=OneWay}">
                        <controls:FeedShellListControl.Header>
                            <Grid x:Name="Pane2Grid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </controls:FeedShellListControl.Header>
                    </controls:FeedShellListControl>
                </Grid>
            </muxc:TwoPaneView.Pane2>
        </muxc:TwoPaneView>
    </Grid>
</Page>
