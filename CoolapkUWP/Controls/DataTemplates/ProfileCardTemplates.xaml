<ResourceDictionary
    x:Class="CoolapkUWP.Controls.DataTemplates.ProfileCardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CoolapkUWP.Models"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:templates="using:CoolapkUWP.Controls.DataTemplates"
    mc:Ignorable="d">

    <templates:ProfileItemTemplateSelector
        x:Key="ProfileItemTemplateSelector"
        Empty="{StaticResource Empty}"
        History="{StaticResource HistoryTemplate}"
        IconLink="{StaticResource IconLinkTemplate}"
        TextLink="{StaticResource TextLinkTemplate}" />

    <DataTemplate x:Key="Empty" />

    <!--  一级卡片  -->

    <DataTemplate x:Key="TextLinkListCardTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <controls:StackPanel Spacing="12">
            <Grid
                x:Name="TitleGrid" HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                Tag="{x:Bind}"
                Visibility="{x:Bind ShowTitle, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText" Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <Button
                    x:Uid="/ProfileFlyoutControl/ReadMoreButton"
                    Grid.Column="1"
                    Padding="4,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Button_Click"
                    FontSize="12"
                    Tag="{x:Bind}"
                    Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <Border
                Background="{ThemeResource ButtonBackground}"
                BorderBrush="{ThemeResource ButtonBorderBrush}"
                BorderThickness="{ThemeResource ButtonBorderThemeThickness}"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Visibility="{x:Bind Entities, Converter={StaticResource CollectionVisibilityConverter}, Mode=OneWay}">
                <muxc:ItemsRepeater
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource ProfileItemTemplateSelector}"
                    ItemsSource="{x:Bind Entities, Mode=OneWay}" />
            </Border>
            <TextBlock
                Margin="12,0"
                VerticalAlignment="Center"
                FontSize="14"
                Text="{x:Bind Description, Mode=OneWay}"
                Visibility="{x:Bind Description, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        </controls:StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ImageTextScrollCardTemplate" x:DataType="models:IndexPageHasEntitiesModel">
        <controls:StackPanel Spacing="12">
            <Grid
                x:Name="TitleGrid" HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlTransparentBrush}"
                Tag="{x:Bind}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText" Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <Button
                    x:Uid="/ProfileFlyoutControl/ReadMoreButton"
                    Grid.Column="1"
                    Padding="4,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Button_Click"
                    FontSize="12"
                    Tag="{x:Bind}"
                    Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
            <muxc:ItemsRepeaterScrollHost>
                <ScrollViewer
                    Margin="0,0,0,-12"
                    Padding="0,0,0,12"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollMode="Disabled">
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource ProfileItemTemplateSelector}" ItemsSource="{x:Bind Entities, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Orientation="Horizontal" Spacing="6" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </muxc:ItemsRepeaterScrollHost>
        </controls:StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TitleCardTemplate" x:DataType="models:IndexPageOperationCardModel">
        <Grid
            x:Name="TitleGrid" HorizontalAlignment="Stretch"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Tag="{x:Bind}"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText" Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            <Button
                x:Uid="/ProfileFlyoutControl/ReadMoreButton"
                Grid.Column="1"
                Padding="4,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="Button_Click"
                FontSize="12"
                Tag="{x:Bind}"
                Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <!--  二级卡片  -->

    <DataTemplate x:Key="HistoryTemplate" x:DataType="models:IHasDescription">
        <Button
            Padding="0,8"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="Button_Click"
            Style="{StaticResource TransparentButtonStyle}"
            Tag="{x:Bind Url, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <controls:ImageEx
                        Model="{x:Bind Pic}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Stretch="UniformToFill" />
                </Border>
                <Grid
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Title, Mode=OneWay}"
                        Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    <controls:TextBlockEx
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind Description, Mode=OneWay}"
                        Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="IconLinkTemplate" x:DataType="models:IndexPageModel">
        <Button
            Width="86"
            Padding="4"
            Click="Button_Click"
            Tag="{x:Bind Url, Mode=OneWay}">
            <StackPanel CornerRadius="{ThemeResource ControlCornerRadius}">
                <Border
                    Width="36"
                    Height="36"
                    Margin="4"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <controls:ImageEx
                        Model="{x:Bind Pic}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Stretch"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SubTitle" HorizontalAlignment="Stretch"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind SubTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind SubTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="TextLinkTemplate" x:DataType="models:IndexPageModel">
        <Button
            Padding="8"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="Button_Click"
            Style="{StaticResource TransparentButtonStyle}"
            Tag="{x:Bind Url, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ImageEx
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Model="{x:Bind Pic}"
                    CornerRadius="10"
                    Stretch="Uniform" />
                <TextBlock
                    Grid.Column="2"
                    Margin="0,0,0,2"
                    VerticalAlignment="Center"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
