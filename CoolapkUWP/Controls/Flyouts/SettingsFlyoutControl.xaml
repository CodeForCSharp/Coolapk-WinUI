<UserControl
    x:Class="CoolapkUWP.Controls.SettingsFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:CommunityToolkit.WinUI.Helpers"
    xmlns:interopservices="using:System.Runtime.InteropServices"
    xmlns:local="using:CoolapkUWP.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settingspages="using:CoolapkUWP.ViewModels.SettingsPages"
    d:DataContext="{d:DesignInstance Type=settingspages:SettingsViewModel}"
    Loaded="SettingsFlyout_Loaded"
   
    Unloaded="SettingsFlyout_Unloaded"
    mc:Ignorable="d">
    <StackPanel x:Name="StackPanel">
        <StackPanel.ChildrenTransitions>
            <TransitionCollection>
                <ReorderThemeTransition />
            </TransitionCollection>
        </StackPanel.ChildrenTransitions>
        <local:SettingsGroup x:Uid="/SettingsPage/DisplaySettingsHeader" Margin="0,-28,0,0">
            <local:Setting x:Uid="/SettingsPage/ThemeSettings" Icon="&#xE790;">
                <local:Setting.Description>
                    <HyperlinkButton
                        x:Uid="/SettingsPage/WindowsColorButton"
                        Click="HyperlinkButton_Click"
                        Tag="WindowsColor" />
                </local:Setting.Description>
                <ComboBox SelectedIndex="{x:Bind Provider.SelectedTheme, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="/SettingsPage/RadioThemeDark" />
                    <ComboBoxItem x:Uid="/SettingsPage/RadioThemeLight" />
                    <ComboBoxItem x:Uid="/SettingsPage/RadioThemeDefault" />
                </ComboBox>
            </local:Setting>
            <local:Setting x:Uid="/SettingsPage/NoPicsModeSettings" Icon="&#xEB9F;">
                <ToggleSwitch IsOn="{x:Bind Provider.IsNoPicsMode, Mode=TwoWay}" Style="{StaticResource ToggleSwitchSettingStyle}" />
            </local:Setting>
            <local:Setting x:Uid="/SettingsPage/DisplayOriginPictureSettings" Icon="&#xE8B9;">
                <ToggleSwitch IsOn="{x:Bind Provider.IsDisplayOriginPicture, Mode=TwoWay}" Style="{StaticResource ToggleSwitchSettingStyle}" />
            </local:Setting>
            <local:Setting x:Uid="/SettingsPage/TileUpdateTimeSettings" Icon="&#xEA79;">
                <Slider
                    Width="{StaticResource SettingCardContentMinWidth}"
                    Maximum="1440"
                    Minimum="0"
                    StepFrequency="15"
                    TickFrequency="15"
                    TickPlacement="Outside"
                    Value="{x:Bind Provider.TileUpdateTime, Mode=TwoWay}" />
            </local:Setting>
        </local:SettingsGroup>
        <local:SettingsGroup
            x:Name="AccountSettingsHeader"
            x:Uid="/SettingsPage/AccountSettingsHeader"
            Visibility="{x:Bind Provider.IsLogin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <local:Setting
                x:Uid="/SettingsPage/AccountSettings"
                Click="Button_Click"
                Icon="&#xEF58;"
                IsClickEnabled="True"
                Tag="AccountSetting" />
            <local:Setting x:Uid="/SettingsPage/LogoutSettings">
                <local:Setting.Icon>
                    <FontIcon

                        Glyph="&#xF3B1;"
                        FontFamily="{StaticResource SymbolThemeFontFamily}" />
                </local:Setting.Icon>
                <Button x:Name="AccountLogout" x:Uid="/SettingsPage/LogoutSettingsButton">
                    <Button.Flyout>
                        <Flyout ShouldConstrainToRootBounds="False">
                            <StackPanel>
                                <TextBlock
                                    x:Uid="/SettingsPage/AccountLogoutTitle"
                                    Margin="0,0,0,12"
                                    Style="{ThemeResource BaseTextBlockStyle}" />
                                <Button
                                    x:Uid="/SettingsPage/AccountLogoutConfirm"
                                    Click="Button_Click"
                                    Tag="AccountLogout" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </local:Setting>
        </local:SettingsGroup>
        <local:SettingsGroup x:Uid="/SettingsPage/AboutSettingsHeader">
            <local:SettingExpander Header="{x:Bind Provider.VersionTextBlockText, Mode=OneWay}" Icon="&#xE117;">
                <local:SettingExpander.Description>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="WrapWholeWords">
                            <Run x:Uid="/SettingsPage/LastChecked" />
                            <Run Text="{x:Bind Provider.UpdateDate, Mode=OneWay}" />
                        </TextBlock>
                        <ScrollViewer
                            Margin="0,2,0,0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <HyperlinkButton
                                    x:Name="FeedbackLinkButton"
                                    x:Uid="/SettingsPage/FeedbackLink"
                                    Margin="0,0,2,0"
                                    NavigateUri="https://github.com/Coolapk-UWP/Coolapk-UWP/issues"
                                    ToolTipService.ToolTip="{x:Bind FeedbackLinkButton.NavigateUri}" />
                                <HyperlinkButton
                                    x:Uid="/SettingsPage/LogFolderLink"
                                    Margin="2,0"
                                    Click="HyperlinkButton_Click"
                                    Tag="LogFolder">
                                    <HyperlinkButton.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="MenuFlyoutItem_Click"
                                                Tag="OpenLogFile"
                                                Text="打开最近的日志">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7C3;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </HyperlinkButton.ContextFlyout>
                                </HyperlinkButton>
                                <HyperlinkButton
                                    x:Name="TranslateLinkButton"
                                    x:Uid="/SettingsPage/TranslateLink"
                                    Margin="2,0"
                                    NavigateUri="https://crowdin.com/project/CoolapkUWP"
                                    ToolTipService.ToolTip="{x:Bind FeedbackLinkButton.NavigateUri}" />
                                <HyperlinkButton
                                    x:Name="ReleaseNotesButton"
                                    x:Uid="/SettingsPage/ReleaseNotes"
                                    Margin="2,0"
                                    NavigateUri="https://github.com/Coolapk-UWP/Coolapk-UWP/releases/latest"
                                    ToolTipService.ToolTip="{x:Bind FeedbackLinkButton.NavigateUri}" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </local:SettingExpander.Description>
                <local:SettingExpander.ActionContent>
                    <local:StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="18">
                        <Border Visibility="{x:Bind Provider.CheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <Border.Child>
                                <muxc:ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsActive="{x:Bind Provider.CheckingUpdate, Mode=OneWay}" />
                            </Border.Child>
                        </Border>
                        <TextBlock
                            x:Name="CheckingUpdateText"
                            x:Uid="/SettingsPage/CheckingUpdates"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Provider.CheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <Button
                            x:Name="UpdateButton"
                            x:Uid="/SettingsPage/CheckUpdates"
                            HorizontalAlignment="Right"
                            Click="Button_Click"
                            Tag="CheckUpdate"
                            Visibility="{x:Bind Provider.CheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" />
                    </local:StackPanel>
                </local:SettingExpander.ActionContent>
                <Grid Style="{StaticResource SettingExpanderContentGridStyle}">
                    <TextBlock TextWrapping="Wrap"
                        HorizontalAlignment="Left"
                        
                        Text="{x:Bind Provider.AboutTextBlockText, Mode=OneWay}" />
                </Grid>
            </local:SettingExpander>
            <muxc:InfoBar
                x:Name="UpdateState"
                Title="{x:Bind Provider.UpdateStateTitle, Mode=OneWay}"
                IsClosable="True"
                IsOpen="{x:Bind Provider.UpdateStateIsOpen, Mode=OneWay}"
                Message="{x:Bind Provider.UpdateStateMessage, Mode=OneWay}"
                Severity="{x:Bind Provider.UpdateStateSeverity, Mode=OneWay}">
                <muxc:InfoBar.ActionButton>
                    <Button
                        x:Uid="/SettingsPage/GoToUpdate"
                        HorizontalAlignment="Right"
                        Click="GotoUpdate_Click"
                        Tag="{x:Bind Provider.GotoUpdateTag, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Provider.GotoUpdateTag, Mode=OneWay}"
                        Visibility="{x:Bind Provider.GotoUpdateVisibility, Mode=OneWay}" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>
            <local:SettingExpander x:Uid="/SettingsPage/FrameworkSettings" Icon="&#xE950;">
                <Grid Style="{StaticResource SettingExpanderContentGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Uid="/SettingsPage/FrameworkTextBlock"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="0,0,0,8"
                        Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="32,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind interopservices:RuntimeInformation.FrameworkDescription}"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="0,0,0,8"
                        Foreground="{ThemeResource CardPrimaryForegroundBrush}"
                        Text="Community Toolkit" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="32,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind settingspages:SettingsViewModel.ToolkitVersion}"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        x:Uid="/SettingsPage/DeviceFamilyTextBlock"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="0,0,0,8"
                        Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Padding="32,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind settingspages:SettingsViewModel.DeviceFamily}"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        x:Uid="/SettingsPage/OSPlatformTextBlock"
                        Grid.Row="3"
                        Grid.Column="0"
                        Padding="0,0,0,8"
                        Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Padding="32,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind OSVersion}"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        x:Uid="/SettingsPage/OSArchitectureTextBlock"
                        Grid.Row="4"
                        Grid.Column="0"
                        Padding="0,0,0,8"
                        Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Padding="32,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind interopservices:RuntimeInformation.OSArchitecture}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </local:SettingExpander>
        </local:SettingsGroup>
        <local:SettingsGroup x:Uid="/SettingsPage/OthersSettingsHeader">
            <local:Setting x:Uid="/SettingsPage/ShowOtherExceptionSettings" Icon="&#xE90F;">
                <ToggleSwitch IsOn="{x:Bind Provider.ShowOtherException, Mode=TwoWay}" Style="{StaticResource ToggleSwitchSettingStyle}" />
            </local:Setting>
            <local:Setting x:Uid="/SettingsPage/CleanCacheSettings" Icon="&#xEA99;">
                <local:StackPanel Orientation="Horizontal" Spacing="18">
                    <Border Visibility="{x:Bind Provider.IsCleanCache, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <Border.Child>
                            <muxc:ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind Provider.IsCleanCache, Mode=OneWay}" />
                        </Border.Child>
                    </Border>
                    <Button
                        x:Uid="/SettingsPage/CleanCacheButton"
                        Click="Button_Click"
                        IsEnabled="{x:Bind Provider.IsCleanCache, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Tag="CleanCache" />
                </local:StackPanel>
            </local:Setting>
            <local:Setting x:Uid="/SettingsPage/ResetSettings" Icon="&#xE777;">
                <Button x:Name="Reset" x:Uid="/SettingsPage/ResetSettingsButton">
                    <Button.Flyout>
                        <Flyout ShouldConstrainToRootBounds="False">
                            <StackPanel>
                                <TextBlock
                                    x:Uid="/SettingsPage/ResetSettingsTitle"
                                    Margin="0,0,0,12"
                                    Style="{ThemeResource BaseTextBlockStyle}" />
                                <Button
                                    x:Uid="/SettingsPage/ResetSettingsConfirm"
                                    Click="Button_Click"
                                    Tag="Reset" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </local:Setting>
        </local:SettingsGroup>
    </StackPanel>
</UserControl>
