    <DataTemplate x:Key="ColorfulScrollCardItemTemplate" x:DataType="models:IndexPageModel">
        <Button
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Background="{ThemeResource SystemControlTransparentBrush}"
            Click="Button_Click"
            Style="{ThemeResource TransparentButtonStyle}"
            Tag="{x:Bind}">
            <Border
                x:Name="ColorfulItemBorder"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Loaded="ColorfulItem_Loaded"
                Tag="{x:Bind Pic.Uri}">
                <Grid Width="88" Padding="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <control:ImageEx
                        Model="{x:Bind Pic}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    MaxLines="2"
                    FontSize="12"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        FontSize="11"
                        FontWeight="Bold"
                        Text="{x:Bind StarAverageScore, Mode=OneWay}"
                        Visibility="{x:Bind StarAverageScore, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="0"
                        Visibility="{x:Bind RatingTotalNumTxt, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind RatingTotalNumTxt, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="人点评" />
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

