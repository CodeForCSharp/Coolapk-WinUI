                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8EA;"
                                Visibility="{x:Bind DeviceTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind DeviceTitle, Mode=OneWay}"
                                Visibility="{x:Bind DeviceTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,6"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Border
                        Padding="3,1"
                        VerticalAlignment="Center"
                        Background="#FFF1FF"
                        BorderBrush="#A866E5"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="10"
                                Foreground="#A866E5"
                                Glyph="&#xE8EA;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#A866E5"
                                Text="机主评分" />
                        </StackPanel>
                    </Border>
                    <ItemsControl
                        VerticalAlignment="Center"
                        ItemTemplate="{StaticResource RatingStarTemplate}"
                        ItemsSource="{x:Bind OverallStars, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border
                        Padding="1,0"
                        VerticalAlignment="Center"
                        Background="#FFF1DF"
                        CornerRadius="8"
                        Visibility="{x:Bind OverallRatingDescriptor, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <TextBlock
                                FontSize="14"
                                Text="&#x1F60D;" />
                            <TextBlock
                                Margin="0,0,4,0"
                                FontSize="11"
                                Foreground="#E48720"
                                Text="{x:Bind OverallRatingDescriptor, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    LineHeight="16"
                    Text="{x:Bind RatingItemsText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind RatingItemsText, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />

                <Border
                    Grid.Row="3"
                    Margin="0,0,0,6"
                    Padding="4,2"
                    HorizontalAlignment="Left"
                    Background="#159B55"
                    CornerRadius="4"
                    Visibility="{x:Bind FeedTypeName, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                    <TextBlock
                        FontSize="12"
                        Foreground="White"
                        Text="{x:Bind FeedTypeName, Mode=OneWay}" />
                </Border>

                <control:TextBlockEx
                    Grid.Row="4"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    Text="{x:Bind Message, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Message, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />

                <Border
                    Grid.Row="5"
                    Margin="0,0,0,8"
                    Padding="10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Tag="{x:Bind}"
                    Tapped="RatingTargetRow_Tapped"
                    Visibility="{x:Bind TargetRowTitle, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            VerticalAlignment="Center"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <control:ImageEx
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Model="{x:Bind TargetRowLogo, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind TargetRowTitle, Mode=OneWay}" />
                            <StackPanel
                                Margin="0,2,0,0"
                                Orientation="Horizontal"
                                Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind TargetRowStarTotalCount, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="人 点评" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="{x:Bind TargetRowStarAverageScore, Mode=OneWay}" />
                            <ItemsControl
                                Margin="0,2,0,0"
                                ItemTemplate="{StaticResource RatingStarSmallTemplate}"
                                ItemsSource="{x:Bind TargetStars, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="6" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8E1;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE90A;" />
                    <FontIcon
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE72D;" />
                </Grid>
            </Grid>
        </UserControl>
    </DataTemplate>

