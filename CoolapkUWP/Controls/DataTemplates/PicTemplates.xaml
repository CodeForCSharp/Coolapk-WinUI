<ResourceDictionary
    x:Class="CoolapkUWP.Controls.DataTemplates.PicTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CoolapkUWP.Controls"
      xmlns:images="using:CoolapkUWP.Models.Images">
    <DataTemplate x:Key="PicDefaultTemplate" x:DataType="images:ImageModel">
        <Border
            Width="102"
            Height="102"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            DragStarting="Border_DragStarting"
            KeyDown="Image_KeyDown"
            Tag="{x:Bind}"
            Tapped="Image_Tapped">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Name="RefreshButton"
                        x:Uid="/ShowImagePage/RefreshMenuItem"
                        Click="AppBarButton_Click"
                        Tag="{x:Bind}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="CopyButton"
                        x:Uid="/ShowImagePage/CopyMenuItem"
                        Click="AppBarButton_Click"
                        Tag="{x:Bind}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="ShareButton"
                        x:Uid="/ShowImagePage/ShareMenuItem"
                        Click="AppBarButton_Click"
                        Tag="{x:Bind}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="SaveButton"
                        x:Uid="/ShowImagePage/SaveMenuItem"
                        Click="AppBarButton_Click"
                        Tag="{x:Bind}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74E;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
            <Grid>
                <controls:ImageEx
                    Model="{x:Bind}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Stretch="UniformToFill" />
                <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Border
                        x:Name="GIF"
                        Padding="4,2"
                        Background="#0F9D58"
                        CornerRadius="0,8,0,8"
                        Visibility="{x:Bind IsGif, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            FontSize="12"
                            Foreground="White"
                            Text="GIF" />
                    </Border>
                </Grid>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Border
                        x:Name="LongPic"
                        Padding="4,2"
                        Background="#0F9D58"
                        CornerRadius="8,0,8,0"
                        Visibility="{x:Bind IsLongPic, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            x:Uid="/Feed/LongPic"
                            FontSize="12"
                            Foreground="White" />
                    </Border>
                    <Border
                        x:Name="WidePic"
                        Padding="4,2"
                        Background="#0F9D58"
                        CornerRadius="8,0,8,0"
                        Visibility="{x:Bind IsWidePic, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            x:Uid="/Feed/WidePic"
                            FontSize="12"
                            Foreground="White" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
