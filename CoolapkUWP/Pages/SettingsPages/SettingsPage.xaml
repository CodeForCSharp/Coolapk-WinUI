<Page
    x:Class="CoolapkUWP.Pages.SettingsPages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:CommunityToolkit.WinUI.Helpers"
    xmlns:interopservices="using:System.Runtime.InteropServices"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settingspages="using:CoolapkUWP.ViewModels.SettingsPages"
    d:DataContext="{d:DesignInstance Type=settingspages:SettingsViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader x:Name="HeaderControl" Title="{Binding Title}" />
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StackPanel">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <controls:SettingsGroup x:Uid="DisplaySettingsHeader">
                    <controls:Setting x:Uid="ThemeSettings" Icon="&#xE790;">
                        <controls:Setting.Description>
                            <HyperlinkButton
                                x:Uid="WindowsColorButton"
                                Click="HyperlinkButton_Click"
                                Tag="WindowsColor" />
                        </controls:Setting.Description>
                        <ComboBox SelectedIndex="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="RadioThemeDark" />
                            <ComboBoxItem x:Uid="RadioThemeLight" />
                            <ComboBoxItem x:Uid="RadioThemeDefault" />
                        </ComboBox>
                    </controls:Setting>
                    <controls:Setting x:Uid="NoPicsModeSettings" Icon="&#xEB9F;">
                        <ToggleSwitch IsOn="{Binding IsNoPicsMode, Mode=TwoWay}" Style="{StaticResource ToggleSwitchSettingStyle}" />
                    </controls:Setting>
                    <controls:Setting x:Uid="UseMultiWindowSettings" Icon="&#xE78B;">
                        <ToggleSwitch IsOn="{Binding IsUseMultiWindow, Mode=TwoWay}" Style="{StaticResource ToggleSwitchSettingStyle}" />
                    </controls:Setting>
                    <controls:Setting x:Uid="DisplayOriginPictureSettings" Icon="&#xE8B9;">
                        <ToggleSwitch IsOn="{Binding IsDisplayOriginPicture, Mode=TwoWay}" Style="{StaticResource ToggleSwitchSettingStyle}" />
                    </controls:Setting>
                    <controls:Setting x:Uid="TileUpdateTimeSettings" Icon="&#xEA79;">
                        <Slider
                            Width="{StaticResource SettingCardContentMinWidth}"
                            Maximum="1440"
                            Minimum="0"
                            StepFrequency="15"
                            TickFrequency="15"
                            TickPlacement="Outside"
                            Value="{Binding TileUpdateTime, Mode=TwoWay}" />
                    </controls:Setting>
                </controls:SettingsGroup>
                <controls:SettingsGroup
                    x:Name="AccountSettingsHeader"
                    x:Uid="AccountSettingsHeader"
                    Visibility="{Binding IsLogin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:Setting
                        x:Uid="AccountSettings"
                        Click="Button_Click"
                        Icon="&#xEF58;"
                        IsClickEnabled="True"
                        Tag="AccountSetting" />
                    <controls:Setting x:Uid="LogoutSettings">
                        <controls:Setting.Icon>
                            <FontIcon

                                Glyph="&#xF3B1;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </controls:Setting.Icon>
                        <Button x:Name="AccountLogout" x:Uid="LogoutSettingsButton">
                            <Button.Flyout>
                                <Flyout ShouldConstrainToRootBounds="False">
                                    <StackPanel>
                                        <TextBlock
                                            x:Uid="AccountLogoutTitle"
                                            Margin="0,0,0,12"
                                            Style="{ThemeResource BaseTextBlockStyle}" />
                                        <Button
                                            x:Uid="AccountLogoutConfirm"
                                            Click="Button_Click"
                                            Tag="AccountLogout" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </controls:Setting>
                </controls:SettingsGroup>
                <controls:SettingsGroup x:Uid="AboutSettingsHeader">
                    <controls:SettingExpander Header="{Binding VersionTextBlockText}" Icon="&#xE117;">
                        <controls:SettingExpander.Description>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="WrapWholeWords">
                                    <Run x:Uid="LastChecked" />
                                    <Run Text="{Binding UpdateDate, Mode=OneWay}" />
                                </TextBlock>
                                <ScrollViewer
                                    Margin="0,2,0,0"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal">
                                        <HyperlinkButton
                                            x:Uid="FeedbackLink"
                                            Margin="0,0,2,0"
                                            NavigateUri="https://github.com/Coolapk-UWP/Coolapk-UWP/issues"
                                            ToolTipService.ToolTip="{Binding NavigateUri, RelativeSource={RelativeSource Mode=Self}}" />
                                        <HyperlinkButton
                                            x:Uid="LogFolderLink"
                                            Margin="2,0"
                                            Click="HyperlinkButton_Click"
                                            Tag="LogFolder">
                                            <HyperlinkButton.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="MenuFlyoutItem_Click"
                                                        Tag="OpenLogFile"
                                                        Text="打开最近的日志">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7C3;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </HyperlinkButton.ContextFlyout>
                                        </HyperlinkButton>
                                        <HyperlinkButton
                                            x:Uid="TranslateLink"
                                            Margin="2,0"
                                            NavigateUri="https://crowdin.com/project/CoolapkUWP"
                                            ToolTipService.ToolTip="{Binding NavigateUri, RelativeSource={RelativeSource Mode=Self}}" />
                                        <HyperlinkButton
                                            x:Uid="ReleaseNotes"
                                            Margin="2,0"
                                            NavigateUri="https://github.com/Coolapk-UWP/Coolapk-UWP/releases/latest"
                                            ToolTipService.ToolTip="{Binding NavigateUri, RelativeSource={RelativeSource Mode=Self}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </controls:SettingExpander.Description>
                        <controls:SettingExpander.ActionContent>
                            <controls:StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="18">
                                <Border Visibility="{Binding CheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Child>
                                        <muxc:ProgressRing
                                            Width="24"
                                            Height="24"
                                            IsActive="{Binding CheckingUpdate}" />
                                    </Border.Child>
                                </Border>
                                <TextBlock
                                    x:Name="CheckingUpdateText"
                                    x:Uid="CheckingUpdates"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{Binding CheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button
                                    x:Name="UpdateButton"
                                    x:Uid="CheckUpdates"
                                    HorizontalAlignment="Right"
                                    Click="Button_Click"
                                    Tag="CheckUpdate"
                                    Visibility="{Binding CheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true'}" />
                            </controls:StackPanel>
                        </controls:SettingExpander.ActionContent>
                        <Grid Style="{StaticResource SettingExpanderContentGridStyle}">
                            <TextBlock TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                
                                Text="{Binding AboutTextBlockText}" />
                        </Grid>
                    </controls:SettingExpander>
                    <muxc:InfoBar
                        x:Name="UpdateState"
                        Title="{Binding UpdateStateTitle}"
                        IsClosable="True"
                        IsOpen="{Binding UpdateStateIsOpen, Mode=TwoWay}"
                        Message="{Binding UpdateStateMessage}"
                        Severity="{Binding UpdateStateSeverity}"
                        Visibility="{Binding UpdateStateIsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <muxc:InfoBar.ActionButton>
                            <Button
                                x:Uid="GoToUpdate"
                                HorizontalAlignment="Right"
                                Click="GotoUpdate_Click"
                                Tag="{Binding GotoUpdateTag}"
                                ToolTipService.ToolTip="{Binding GotoUpdateTag}"
                                Visibility="{Binding GotoUpdateVisibility}" />
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>
                    <controls:SettingExpander x:Uid="FrameworkSettings" Icon="&#xE950;">
                        <Grid Style="{StaticResource SettingExpanderContentGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Uid="FrameworkTextBlock"
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="0,0,0,8"
                                Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="32,0,0,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind interopservices:RuntimeInformation.FrameworkDescription}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="0,0,0,8"
                                Foreground="{ThemeResource CardPrimaryForegroundBrush}"
                                Text="Community Toolkit" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="32,0,0,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding ToolkitVersion}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                x:Uid="DeviceFamilyTextBlock"
                                Grid.Row="2"
                                Grid.Column="0"
                                Padding="0,0,0,8"
                                Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Padding="32,0,0,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding DeviceFamily}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                x:Uid="OSPlatformTextBlock"
                                Grid.Row="3"
                                Grid.Column="0"
                                Padding="0,0,0,8"
                                Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Padding="32,0,0,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind OSVersion}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                x:Uid="OSArchitectureTextBlock"
                                Grid.Row="4"
                                Grid.Column="0"
                                Padding="0,0,0,8"
                                Foreground="{ThemeResource CardPrimaryForegroundBrush}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Padding="32,0,0,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind interopservices:RuntimeInformation.OSArchitecture}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </controls:SettingExpander>
                    <controls:Setting x:Uid="CleanCacheSettings" Icon="&#xEA99;">
                        <controls:StackPanel Orientation="Horizontal" Spacing="18">
                            <Border Visibility="{Binding IsCleanCache, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Child>
                                    <muxc:ProgressRing
                                        Width="24"
                                        Height="24"
                                        IsActive="{Binding IsCleanCache}" />
                                </Border.Child>
                            </Border>
                            <Button
                                x:Uid="CleanCacheButton"
                                Click="Button_Click"
                                IsEnabled="{Binding IsCleanCache, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                Tag="CleanCache" />
                        </controls:StackPanel>
                    </controls:Setting>
                    <controls:Setting x:Uid="ResetSettings" Icon="&#xE777;">
                        <Button x:Name="Reset" x:Uid="ResetSettingsButton">
                            <Button.Flyout>
                                <Flyout ShouldConstrainToRootBounds="False">
                                    <StackPanel>
                                        <TextBlock
                                            x:Uid="ResetSettingsTitle"
                                            Margin="0,0,0,12"
                                            Style="{ThemeResource BaseTextBlockStyle}" />
                                        <Button
                                            x:Uid="ResetSettingsConfirm"
                                            Click="Button_Click"
                                            Tag="Reset" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </controls:Setting>
                </controls:SettingsGroup>
                <controls:SettingsGroup x:Uid="OthersSettingsHeader">
                    <controls:Setting x:Uid="ShowOtherExceptionSettings" Icon="&#xE90F;">
                        <ToggleSwitch IsOn="{Binding ShowOtherException, Mode=TwoWay}" Style="{StaticResource ToggleSwitchSettingStyle}" />
                    </controls:Setting>
                    <controls:Setting
                        x:Name="GoToTestPage"
                        x:Uid="GoToTestPage"
                        Click="Button_Click"
                        Icon="&#xEC7A;"
                        IsClickEnabled="True"
                        Tag="TestPage" />
                </controls:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <VisualState x:Name="LargeLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1372" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControl.Padding" Value="80,32,32,0" />
                        <Setter Target="StackPanel.Padding" Value="80,0,32,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource Breakpoint640Plus}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControl.Padding" Value="56,32,32,0" />
                        <Setter Target="StackPanel.Padding" Value="56,0,32,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControl.Padding" Value="16,0,16,0" />
                        <Setter Target="StackPanel.Padding" Value="16,0,16,16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
