<ResourceDictionary
    x:Class="CoolapkUWP.Controls.DataTemplates.RelationRowsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:feeds="using:CoolapkUWP.Models.Feeds"
    mc:Ignorable="d">

    <DataTemplate x:Key="RelationRowsItemTemplate" x:DataType="feeds:RelationRowsItem">
        <Button
            MinHeight="0"
            Padding="0"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="Button_Click"
            Tag="{x:Bind Url, Mode=OneWay}">
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="20"
                    Height="20"
                    Margin="0,0,4,0"
                    Visibility="{x:Bind IsShowIcon, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Viewbox
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind IsShowLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='true', Mode=OneWay}">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{x:Bind Icon, Mode=OneWay}" />
                    </Viewbox>
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind IsShowLogo, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <controls:ImageEx
                            Model="{x:Bind Logo}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Stretch="UniformToFill" />
                    </Border>
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind Title, Mode=OneWay}"
                    Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="ReplyRowsItemTemplate" x:DataType="feeds:SourceFeedReplyModel">
        <Grid
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{x:Bind Message, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
            <controls:TextBlockEx
                Margin="4"
                VerticalAlignment="Center"
                Text="{x:Bind Message, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="VoteItemTemplate" x:DataType="feeds:VoteItem">
        <Grid
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{x:Bind Title, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse
                Width="10"
                Height="10"
                Margin="8,4,8,8"
                VerticalAlignment="Center"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeThickness="1">
                <Ellipse.Fill>
                    <SolidColorBrush Color="{x:Bind Color, Mode=OneWay}" />
                </Ellipse.Fill>
            </Ellipse>
            <controls:TextBlockEx
                Grid.Column="1"
                Margin="0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsTextSelectionEnabled="True"
                Text="{x:Bind Title, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
