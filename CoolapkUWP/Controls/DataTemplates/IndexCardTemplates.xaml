                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <muxc:PersonPicture
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        DisplayName="{x:Bind UserInfo.UserName, Mode=OneWay}"
